+  std::string utf8 = source.Utf8();
+  size_t out_len = 0;
+  const char* reply =
+      msy_context_repl_turn(context_, utf8.data(), utf8.size(), &out_len);
+  return reply ? String::FromUtf8(std::string_view(reply, out_len)) : String("");
