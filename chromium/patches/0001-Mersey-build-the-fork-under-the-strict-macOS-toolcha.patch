+        ALLOW_DISCOURAGED_TYPE("raw byte payload crossing the engine C ABI");
     int canvas_ctx_id = -1;     // kCanvasCtx: id into the modules-side registry
     // Oilpan-managed web objects the engine holds by handle. Persistent (not
     // Member): this table is an untraced std::vector, and the freelist recycles
@@ -261,18 +263,23 @@ class CORE_EXPORT MerseyScriptRunner
   // Backing store for HostGetText's reply-pointer contract.
   std::string get_text_scratch_;
   // The value handle table (URL/global; handle = -slot - 2) and its freelist.
-  std::vector<NativeObject> native_objects_;
-  std::vector<uint32_t> native_free_;
+  std::vector<NativeObject> native_objects_
+      ALLOW_DISCOURAGED_TYPE("engine handle table; NativeObject is not GC-traced");
+  std::vector<uint32_t> native_free_
+      ALLOW_DISCOURAGED_TYPE("freelist of raw slot indices");
   // The Oilpan node handle table (traced) and its freelist.
   HeapVector<Member<Node>> node_handles_;
-  std::vector<uint32_t> node_free_;
+  std::vector<uint32_t> node_free_
+      ALLOW_DISCOURAGED_TYPE("freelist of raw slot indices");
   // Backing store for the web bridge's reply-pointer contract.
   std::string web_reply_scratch_;
   // Backing store for a typed UTF-16 reply (msy_reply::str16).
-  std::vector<uint16_t> reply_str16_;
+  std::vector<uint16_t> reply_str16_
+      ALLOW_DISCOURAGED_TYPE("UTF-16 code units for the engine reply-pointer contract");
   // Timers the engine armed (`setTimeout`): id -> cancellable task. The bench
   // workload arms + clears; a fired timer erases itself in FireTimer.
-  std::map<int, TaskHandle> timers_;
+  std::map<int, TaskHandle> timers_
+      ALLOW_DISCOURAGED_TYPE("small engine timer-id -> task map");
   int next_timer_id_ = 1;
 };
 
diff --git a/third_party/mersey/BUILD.gn b/third_party/mersey/BUILD.gn
index 02d51f964b..1f1fc93419 100644
--- a/third_party/mersey/BUILD.gn
+++ b/third_party/mersey/BUILD.gn
@@ -1,19 +1,20 @@
 # The Mersey engine: a Rust engine behind a C ABI, linked into Blink.
 #
-# Two shapes, one per host, until the GN Rust-rules follow-up unifies them:
+# Both hosts link the engine as a *cdylib*, and deliberately so. As a staticlib
+# the crate bundles its own copy of Rust's std, and Blink links Chromium's own
+# std — two definitions of `rust_eh_personality` and friends, and the link fails
+# (`-Wl,-z,defs` on Linux; `ld64: duplicate symbol` on macOS). A cdylib exports
+# only the `msy_*` symbols of include/mersey.h and keeps its std internal, which
+# is what a boundary is for. It differs per host only in extension and how the
+# loader is told where the sidecar lives:
 #
-#   Linux — a *shared* library (cdylib). As a staticlib the crate bundles its
-#   own copy of Rust's std, and Blink links Chromium's own prebuilt std — two
-#   definitions of `rust_eh_personality` and friends, and the link fails under
-#   `-Wl,-z,defs`. A cdylib exports only the `msy_*` symbols of include/mersey.h
-#   and keeps its std to itself, which is what a boundary is for. The `.so`
-#   lands beside the binaries, which already carry -rpath=$ORIGIN.
+#   Linux — `libmersey_capi.so`, found at runtime via -rpath=$ORIGIN (the `.so`
+#   lands beside the binaries, which already carry that rpath).
 #
-#   macOS — the prebuilt *staticlib* (`lib/libmersey_capi.a`). The hermetic
-#   toolchain builds Chromium's std from source and links with ld64, which
-#   resolves the engine's bundled std locally instead of failing the link; no
-#   sidecar `.so` to ship and no rpath to set. This is the shape
-#   scripts/build-macos-arm64.sh refreshes into `lib/`.
+#   macOS — `libmersey_capi.dylib` (install_name @rpath/libmersey_capi.dylib),
+#   copied to the build root and found via an absolute -rpath into it. This is a
+#   dev build run from the out dir, not a relocatable .app; the follow-up that
+#   builds the crate with GN's Rust rules removes the sidecar entirely.
 #
 # (The planned follow-up builds the crate graph with GN's Rust rules, which uses
 # Chromium's std and makes both of these moot — and makes all six platform/arch
@@ -24,11 +25,26 @@ config("mersey_include") {
 }
 
 if (is_mac) {
-  # macOS links the prebuilt staticlib straight into the loading binary.
+  # The cdylib is copied to the build root and linked from there; its
+  # @rpath/ install_name resolves against the absolute rpath below.
+  copy("mersey_engine_lib") {
+    sources = [ "lib/libmersey_capi.dylib" ]
+    outputs = [ "$root_out_dir/libmersey_capi.dylib" ]
+  }
+
+  config("mersey_rpath") {
+    ldflags = [ "-Wl,-rpath," + rebase_path(root_out_dir) ]
+  }
+
   source_set("mersey_engine") {
     public = [ "include/mersey.h" ]
-    public_configs = [ ":mersey_include" ]
-    libs = [ rebase_path("lib/libmersey_capi.a") ]
+    public_configs = [
+      ":mersey_include",
+      ":mersey_rpath",
+    ]
+    all_dependent_configs = [ ":mersey_rpath" ]
+    deps = [ ":mersey_engine_lib" ]
+    libs = [ "$root_out_dir/libmersey_capi.dylib" ]
   }
 } else {
   # The engine lands beside the binaries, which already carry -rpath=$ORIGIN.
