diff --git a/front_end/panels/mersey/MerseyDebuggerPanel.ts b/front_end/panels/mersey/MerseyDebuggerPanel.ts
new file mode 100644
index 0000000000..e81d640f18
--- /dev/null
+++ b/front_end/panels/mersey/MerseyDebuggerPanel.ts
@@ -0,0 +1,230 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Mersey debugger, as a DevTools drawer panel.
+//
+// Why not the Sources panel: that panel is built on SDK.DebuggerModel, which
+// speaks the Debugger domain — and that domain is v8_inspector's. The Mersey
+// engine is not V8 and has no V8 contexts, so its scripts can never appear
+// there. This panel drives the fork's own Mersey domain directly.
+
+import * as Common from '../../core/common/common.js';
+import * as SDK from '../../core/sdk/sdk.js';
+import * as UI from '../../ui/legacy/legacy.js';
+
+interface MerseyScript {
+  url: string;
+  source: string;
+}
+
+interface MerseyVariable {
+  name: string;
+  value: string;
+}
+
+interface MerseyScope {
+  name: string;
+  variables: MerseyVariable[];
+}
+
+interface MerseyCallFrame {
+  functionName: string;
+  url: string;
+  lineNumber: number;
+  columnNumber: number;
+  scopeChain: MerseyScope[];
+}
+
+export class MerseyDebuggerPanel extends UI.Widget.VBox {
+  #toolbar: HTMLElement;
+  #status: HTMLElement;
+  #sourceView: HTMLElement;
+  #stackView: HTMLElement;
+  #scripts: MerseyScript[] = [];
+  #selected = 0;
+  // Sources is the sole breakpoint writer (the bridge in mersey-meta): a
+  // second writer with REPLACE semantics was observed clobbering breakpoints
+  // on reload. This panel shows state and steps; it does not own breakpoints.
+  #pausedFrames: MerseyCallFrame[]|null = null;
+  #attached = false;
+
+  constructor() {
+    super(true);
+    this.element.style.overflow = 'auto';
+
+    this.#toolbar = this.contentElement.createChild('div');
+    this.#toolbar.style.cssText =
+        'display:flex;gap:6px;align-items:center;padding:4px 8px;border-bottom:1px solid var(--sys-color-divider);flex-wrap:wrap';
+
+    const button = (label: string, onClick: () => void): HTMLButtonElement => {
+      const b = document.createElement('button');
+      b.textContent = label;
+      b.style.cssText = 'padding:2px 8px;cursor:pointer';
+      b.addEventListener('click', onClick);
+      this.#toolbar.appendChild(b);
+      return b;
+    };
+
+    button('Attach', () => { void this.#attach(); });
+    button('Detach', () => { void this.#send('disableDebugger'); this.#attached = false; this.#render(); });
+    button('Refresh', () => { void this.#loadScripts(); });
+    button('Pause', () => { void this.#send('pause'); });
+    button('Resume', () => { void this.#resumeWith('resume'); });
+    button('Step over', () => { void this.#resumeWith('stepOver'); });
+    button('Step into', () => { void this.#resumeWith('stepInto'); });
+    button('Step out', () => { void this.#resumeWith('stepOut'); });
+
+    this.#status = this.contentElement.createChild('div');
+    this.#status.style.cssText = 'padding:4px 8px;font-family:monospace;white-space:pre-wrap';
+
+    const split = this.contentElement.createChild('div');
+    split.style.cssText = 'display:flex;gap:8px;align-items:flex-start';
+    this.#sourceView = split.createChild('div');
+    this.#sourceView.style.cssText =
+        'flex:2;font-family:monospace;font-size:11px;white-space:pre;overflow:auto;padding:4px 8px';
+    this.#stackView = split.createChild('div');
+    this.#stackView.style.cssText =
+        'flex:1;font-family:monospace;font-size:11px;white-space:pre-wrap;padding:4px 8px;border-left:1px solid var(--sys-color-divider)';
+
+    this.#render();
+    // Attach as soon as the panel is opened. Requiring an explicit Attach
+    // click first meant a breakpoint set beforehand silently never fired.
+    void this.#attach();
+  }
+
+  override wasShown(): void {
+    super.wasShown();
+    // The bridge may have already received the pause this panel is being
+    // opened FOR — a lazy view cannot rely on hearing the event itself.
+    const pending = (window as unknown as {
+                      __merseyDebug?: {lastPause: {reason: string, callFrames: MerseyCallFrame[]}|null},
+                    }).__merseyDebug?.lastPause;
+    if (pending) {
+      this.#pausedFrames = pending.callFrames;
+      this.#status.textContent = `paused (${pending.reason})`;
+      this.#render();
+    }
+    if (!this.#attached) {
+      void this.#attach();
+    } else {
+      void this.#loadScripts();
+    }
+  }
+
+  #target(): SDK.Target.Target|null {
+    return SDK.TargetManager.TargetManager.instance().primaryPageTarget();
+  }
+
+  async #send(method: string, params: object = {}): Promise<any> {
+    const target = this.#target();
+    if (!target) {
+      return null;
+    }
+    // The generated agent has typed wrappers; going through the router keeps
+    // this panel to one code path for every command.
+    return await (target.merseyAgent() as any)['invoke_' + method](params);
+  }
+
+  // Any failure lands in the status line. A debugger that fails silently is
+  // indistinguishable from a debugger that is broken.
+  #fail(where: string, e: unknown): void {
+    this.#status.textContent = `ERROR in ${where}: ${e instanceof Error ? e.message : String(e)}`;
+  }
+
+  async #attach(): Promise<void> {
+    const target = this.#target();
+    if (!target) {
+      this.#status.textContent = "ERROR: no page target";
+      return;
+    }
+    // Mersey.paused arrives while the renderer is blocked inside the engine's
+    // pause callout; the nested message loop is what keeps it deliverable.
+    target.registerMerseyDispatcher({
+      paused: (params: {reason: string, callFrames: MerseyCallFrame[]}) => {
+        this.#pausedFrames = params.callFrames;
+        this.#status.textContent = `paused (${params.reason})`;
+        this.#render();
+      },
+      resumed: () => {
+        this.#pausedFrames = null;
+        this.#status.textContent = 'running';
+        this.#render();
+      },
+    });
+    try {
+      const r = await this.#send('enableDebugger');
+      const err = r?.getError?.();
+      if (err) {
+        this.#fail('enableDebugger', err);
+        return;
+      }
+    } catch (e) {
+      this.#fail('enableDebugger', e);
+      return;
+    }
+    this.#attached = true;
+    await this.#loadScripts();
+    this.#render();
+  }
+
+  async #loadScripts(): Promise<void> {
+    const response = await this.#send('getScripts');
+    this.#scripts = response?.scripts ?? [];
+    this.#render();
+  }
+
+  async #resumeWith(method: string): Promise<void> {
+    this.#pausedFrames = null;
+    this.#status.textContent = 'running';
+    this.#render();
+    await this.#send(method);
+  }
+
+  #render(): void {
+    // Recompute unless paused (the pause handler owns the text then) — a
+    // compute-once status went stale, showing "not attached" after a
+    // successful attach.
+    if (!this.#pausedFrames) {
+      this.#status.textContent = this.#attached ? 'running' : 'not attached';
+    }
+
+    this.#sourceView.removeChildren();
+    const script = this.#scripts[this.#selected];
+    if (!script) {
+      this.#sourceView.createChild('div').textContent =
+          'No Mersey sources yet — run a <script type="text/mersey"> and press Refresh.';
+      return;
+    }
+
+    const pausedLine = this.#pausedFrames?.[0] ? this.#pausedFrames[0].lineNumber + 1 : -1;
+    script.source.split('\n').forEach((text, i) => {
+      const line = i + 1;
+      const row = this.#sourceView.createChild('div');
+      row.style.cssText = 'padding:0 4px';
+      if (line === pausedLine) {
+        row.style.background = 'var(--sys-color-yellow-container, #fdd)';
+      }
+      row.textContent = `${String(line).padStart(3)}  ${text}`;
+    });
+
+    this.#stackView.removeChildren();
+    if (!this.#pausedFrames) {
+      this.#stackView.createChild('div').textContent = 'Not paused.';
+      return;
+    }
+    this.#pausedFrames.forEach((frame, i) => {
+      const head = this.#stackView.createChild('div');
+      head.textContent = `#${i} ${frame.functionName} (${frame.url}:${frame.lineNumber + 1})`;
+      head.style.fontWeight = 'bold';
+      for (const scope of frame.scopeChain) {
+        const s = this.#stackView.createChild('div');
+        s.textContent = `  ${scope.name}`;
+        for (const v of scope.variables) {
+          const row = this.#stackView.createChild('div');
+          row.textContent = `    ${v.name} = ${v.value}`;
+        }
+      }
+    });
+  }
+}
diff --git a/front_end/panels/mersey/mersey-meta.ts b/front_end/panels/mersey/mersey-meta.ts
new file mode 100644
index 0000000000..676c30f5ef
--- /dev/null
+++ b/front_end/panels/mersey/mersey-meta.ts
@@ -0,0 +1,373 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import * as Common from '../../core/common/common.js';
+import * as Platform from '../../core/platform/platform.js';
+import * as SDK from '../../core/sdk/sdk.js';
+import type * as Protocol from '../../generated/protocol.js';
+import * as Bindings from '../../models/bindings/bindings.js';
+import * as Breakpoints from '../../models/breakpoints/breakpoints.js';
+import * as TextUtils from '../../models/text_utils/text_utils.js';
+import * as Workspace from '../../models/workspace/workspace.js';
+import * as UI from '../../ui/legacy/legacy.js';
+
+// Loaded lazily: the panel is only built when the drawer tab is opened.
+let loaded: (typeof import('./mersey.js'))|undefined;
+async function loadMerseyModule(): Promise<typeof import('./mersey.js')> {
+  if (!loaded) {
+    loaded = await import('./mersey.js');
+  }
+  return loaded;
+}
+
+UI.ViewManager.registerViewExtension({
+  // Drawer, not the main strip: Sources is the debugging surface now, and
+  // the drawer auto-opens on pause to provide stack/scopes/stepping.
+  location: UI.ViewManager.ViewLocationValues.DRAWER_VIEW,
+  id: 'mersey-debugger',
+  title: () => 'Mersey' as Common.UIString.LocalizedString,
+  commandPrompt: () => 'Show Mersey debugger' as Common.UIString.LocalizedString,
+  // Right after Sources (30). Order is also overflow priority: the rightmost
+  // tab is the first to vanish behind the chevron in a narrow window, and at
+  // 110 the panel was registered yet INVISIBLE — which reads as broken.
+  order: 35,
+  // PERMANENT, not CLOSEABLE: a closeable drawer view is hidden until the
+  // user finds it in the Command Menu, which made the panel look absent and
+  // the debugger look broken.
+  persistence: UI.ViewManager.ViewPersistence.PERMANENT,
+  async loadView() {
+    const Mersey = await loadMerseyModule();
+    return new Mersey.MerseyDebuggerPanel.MerseyDebuggerPanel();
+  },
+});
+
+
+// ---- Sources-panel integration ---------------------------------------------
+//
+// Mersey debugging THROUGH the Sources panel, the way JS debugs: the page's
+// HTML file is already a Sources resource, and an inline Mersey script lives
+// at known document lines (Mersey.Script.startLine). So:
+//   - a gutter breakpoint in the HTML file, on a line inside a Mersey script,
+//     is translated to an engine line and pushed to Mersey.setBreakpoints;
+//   - when the engine pauses, the document line is revealed in Sources.
+// The Sources pause chrome (call-frame sidebar, F8) stays JS-only — it is
+// built on V8 RemoteObjects — so stack/scopes/stepping live in the Mersey
+// panel. Breakpoints persist with Sources' own storage, so they survive
+// reloads and re-push automatically.
+
+class MerseySourcesBridge implements SDK.TargetManager.Observer {
+  #target: SDK.Target.Target|null = null;
+  // The virtual Sources project. The page's own resource content is often
+  // unavailable ("Resource was not cached"), so the bridge serves each Mersey
+  // script as its own .mersey file — content straight from the engine, and
+  // editor lines mapping 1:1 to engine lines.
+  #project: Bindings.ContentProviderBasedProject.ContentProviderBasedProject|null = null;
+  #virtualUrls = new Map<string, string>();
+  #wired = false;
+  #scripts: Protocol.Mersey.Script[] = [];
+  readonly debug = {
+    lastPause: null as Protocol.Mersey.PausedEvent|null,
+    trace: [] as string[],
+    error: '',
+    scripts: 0,
+    pushes: 0,
+    lastLines: [] as number[],
+    pauses: 0,
+    reveals: 0,
+    resume: () => this.#target?.merseyAgent().invoke_resume({}),
+    stepOver: () => this.#target?.merseyAgent().invoke_stepOver({}),
+    stepInto: () => this.#target?.merseyAgent().invoke_stepInto({}),
+    stepOut: () => this.#target?.merseyAgent().invoke_stepOut({}),
+    // What THIS module's TargetManager can see — settles whether the meta
+    // bundle shares the app's SDK instance or owns a private copy.
+    probe: () => JSON.stringify({
+      targets: SDK.TargetManager.TargetManager.instance().targets().map(t => t.type()),
+      frameEnum: SDK.Target.Type.FRAME,
+    }),
+    setBreakpoint: (docLine0: number) => {
+      const script = this.#scripts[0];
+      if (!script) {
+        return Promise.resolve('no scripts');
+      }
+      const uiSourceCode = Workspace.Workspace.WorkspaceImpl.instance().uiSourceCodeForURL(
+          script.url as Platform.DevToolsPath.UrlString);
+      if (!uiSourceCode) {
+        return Promise.resolve('no uiSourceCode');
+      }
+      return Breakpoints.BreakpointManager.BreakpointManager.instance()
+          .setBreakpoint(
+              uiSourceCode, docLine0, 0, '' as Breakpoints.BreakpointManager.UserCondition, true,
+              false, Breakpoints.BreakpointManager.BreakpointOrigin.OTHER)
+          .then(bp => bp ? 'set' : 'failed');
+    },
+  };
+
+  constructor() {
+    // A truthful in-page diagnostic (release DevTools inlines modules, so app
+    // singletons are unreachable from outside; this is how a probe or a bug
+    // report sees what the bridge actually did).
+    const w = window as unknown as {__merseyDebug: unknown, __merseyBridgeCount?: number};
+    w.__merseyBridgeCount = (w.__merseyBridgeCount ?? 0) + 1;
+    w.__merseyDebug = this.debug;
+    // NOTHING else at module-load time. Meta modules evaluate before the app
+    // constructs its managers; a throw here kills the whole DevTools boot —
+    // observed as an empty window. All wiring waits for the first target.
+    try {
+      SDK.TargetManager.TargetManager.instance().observeTargets(this);
+    } catch (e) {
+      this.debug.error = String(e);
+    }
+  }
+
+  // Runs once, on the first targetAdded — the app is fully wired by then.
+  #wire(): void {
+    if (this.#wired) {
+      return;
+    }
+    this.#wired = true;
+    const breakpointManager = Breakpoints.BreakpointManager.BreakpointManager.instance();
+    breakpointManager.addEventListener(
+        Breakpoints.BreakpointManager.Events.BreakpointAdded, () => this.#pushBreakpoints());
+    breakpointManager.addEventListener(
+        Breakpoints.BreakpointManager.Events.BreakpointRemoved, () => this.#pushBreakpoints());
+    SDK.TargetManager.TargetManager.instance().addModelListener(
+        SDK.ResourceTreeModel.ResourceTreeModel, SDK.ResourceTreeModel.Events.Load, () => {
+          // A reload rebuilds the document, engine, and runner: refresh the
+          // script table and re-arm the persisted breakpoints.
+          void this.#refresh();
+          this.#scheduleRefreshRetries();
+        });
+  }
+
+  targetAdded(target: SDK.Target.Target): void {
+    this.debug.trace.push('targetAdded:' + target.type());
+    try {
+      if (target.type() !== SDK.Target.Type.FRAME) {
+        return;
+      }
+      this.#wire();
+      this.#target = target;
+      this.debug.trace.push('target-set');
+      target.registerMerseyDispatcher({
+        paused: params => this.#revealPause(params),
+        resumed: () => {
+          this.debug.lastPause = null;
+          this.#setSteppingActionsEnabled(false);
+        },
+      });
+      this.debug.trace.push('dispatcher-registered');
+      void this.#refresh().catch(e => {
+        this.debug.error = 'refresh: ' + String(e);
+      });
+      this.#scheduleRefreshRetries();
+    } catch (e) {
+      this.debug.error = 'targetAdded: ' + String(e);
+    }
+  }
+
+  targetRemoved(target: SDK.Target.Target): void {
+    if (target === this.#target) {
+      this.#target = null;
+      this.#scripts = [];
+    }
+  }
+
+  #scheduleRefreshRetries(): void {
+    // An external module graph finishes fetching after the page loads; one
+    // early and one late retry catch it without any notification protocol.
+    for (const delay of [1500, 4000]) {
+      window.setTimeout(() => {
+        void this.#refresh();
+      }, delay);
+    }
+  }
+
+  async #refresh(): Promise<void> {
+    this.debug.trace.push('refresh:start');
+    if (!this.#target) {
+      return;
+    }
+    const response = await this.#target.merseyAgent().invoke_getScripts();
+    this.debug.trace.push('refresh:reply:' + (response.getError() || 'ok') + ':' + (response.scripts?.length ?? -1));
+    this.#scripts = response.getError() ? [] : response.scripts;
+    this.debug.scripts = this.#scripts.length;
+    this.#publishVirtualFiles();
+    await this.#pushBreakpoints();
+  }
+
+  #setSteppingActionsEnabled(enabled: boolean): void {
+    // The Sources toolbar buttons mirror action enabled-state; without this
+    // they stay greyed out when only Mersey (not V8) is paused.
+    for (const id of ['debugger.step-over', 'debugger.step-into', 'debugger.step', 'debugger.step-out']) {
+      try {
+        UI.ActionRegistry.ActionRegistry.instance().getAction(id).setEnabled(enabled);
+      } catch {
+      }
+    }
+  }
+
+  #virtualUrlFor(script: Protocol.Mersey.Script): string {
+    // Stable across reloads (url + tag line), so gutter breakpoints persist.
+    // "page.mersey" for the page's (usually only) script — the ".25" tag-line
+    // suffix read as a mystery file; keep it only to disambiguate a SECOND
+    // inline script on the same page.
+    if (script.url === '<repl>') {
+      return 'mersey://repl.mersey';
+    }
+    const clean = script.url.replace(/[#?].*$/, '');
+    // An external module IS a .mersey resource already: publish it under its
+    // real URL, so the Sources tree shows it where it lives and editor lines
+    // are engine lines with no offset at all.
+    if (clean.endsWith('.mersey')) {
+      return clean;
+    }
+    const base = clean.replace(/\.html?$/, '');
+    const first = this.#scripts.find(other => other.url === script.url);
+    const suffix = first && first.startLine !== script.startLine ? `.${script.startLine}` : '';
+    return `${base}${suffix}.mersey`;
+  }
+
+  #publishVirtualFiles(): void {
+    if (!this.#project) {
+      this.#project = new Bindings.ContentProviderBasedProject.ContentProviderBasedProject(
+          Workspace.Workspace.WorkspaceImpl.instance(), 'mersey-sources',
+          Workspace.Workspace.projectTypes.Network, 'Mersey', false /* isServiceProject */);
+      // Without target/frame attribution the Page navigator filters the
+      // project out entirely — files existed but never appeared in the tree.
+      if (this.#target) {
+        Bindings.NetworkProject.NetworkProject.setTargetForProject(this.#project, this.#target);
+      }
+    }
+    const frameId = this.#target?.model(SDK.ResourceTreeModel.ResourceTreeModel)?.mainFrame?.id;
+    for (const script of this.#scripts) {
+      const url = this.#virtualUrlFor(script);
+      if (this.#virtualUrls.has(url)) {
+        continue;
+      }
+      this.#virtualUrls.set(url, script.url);
+      const provider = new TextUtils.StaticContentProvider.StaticContentProvider(
+          url as Platform.DevToolsPath.UrlString, Common.ResourceType.resourceTypes.Script,
+          () => Promise.resolve(new TextUtils.ContentData.ContentData(
+              script.source, false /* isBase64 */, 'text/javascript')));
+      const uiSourceCode =
+          this.#project.addContentProvider(url as Platform.DevToolsPath.UrlString, provider, 'text/javascript');
+      if (frameId) {
+        Bindings.NetworkProject.NetworkProject.setInitialFrameAttribution(uiSourceCode, frameId);
+      }
+    }
+  }
+
+  // The union of enabled Sources-gutter breakpoints that fall inside any
+  // recorded Mersey script, as engine lines. REPLACE semantics server-side.
+  async #pushBreakpoints(): Promise<void> {
+    if (!this.#target || !this.#scripts.length) {
+      return;
+    }
+    const breakpointManager = Breakpoints.BreakpointManager.BreakpointManager.instance();
+    const workspace = Workspace.Workspace.WorkspaceImpl.instance();
+    const lines = new Set<number>();
+    for (const script of this.#scripts) {
+      const lineCount = script.source.split('\n').length;
+      // The page's own file: document line -> engine line via startLine.
+      const documentCode = workspace.uiSourceCodeForURL(script.url as Platform.DevToolsPath.UrlString);
+      if (documentCode) {
+        for (const location of breakpointManager.breakpointLocationsForUISourceCode(documentCode)) {
+          if (!location.breakpoint.enabled()) {
+            continue;
+          }
+          const engineLine = location.uiLocation.lineNumber - script.startLine;
+          if (engineLine >= 0 && engineLine < lineCount) {
+            lines.add(engineLine);
+          }
+        }
+      }
+      // The virtual .mersey file: editor lines ARE engine lines.
+      const virtualCode = workspace.uiSourceCodeForURL(
+          this.#virtualUrlFor(script) as Platform.DevToolsPath.UrlString);
+      if (virtualCode) {
+        for (const location of breakpointManager.breakpointLocationsForUISourceCode(virtualCode)) {
+          if (!location.breakpoint.enabled()) {
+            continue;
+          }
+          if (location.uiLocation.lineNumber < lineCount) {
+            lines.add(location.uiLocation.lineNumber);
+          }
+        }
+      }
+    }
+    this.debug.pushes++;
+    this.debug.lastLines = [...lines];
+    await this.#target.merseyAgent().invoke_setBreakpoints({url: '', lines: [...lines]});
+  }
+
+  // Jump Sources to the paused document line, exactly as a JS pause would.
+  // The engine names the paused frame's module (a graph spec, "<script>" for
+  // inline); match it to a recorded script, falling back to suffix/basename
+  // the way the engine's own breakpoint matching does.
+  #scriptForFrame(frameUrl: string): Protocol.Mersey.Script|undefined {
+    const basename = (path: string): string => path.split(/[\/\\]/).pop() ?? path;
+    return this.#scripts.find(script => script.spec === frameUrl) ??
+        this.#scripts.find(
+            script => script.url.endsWith(frameUrl) || frameUrl.endsWith(script.url) ||
+                basename(script.url) === basename(frameUrl)) ??
+        this.#scripts[0];
+  }
+
+  #revealPause(params: Protocol.Mersey.PausedEvent): void {
+    this.debug.pauses++;
+    // The panel is lazy: if it opens AFTER this event fired, it must still
+    // find the pause. resumed() clears it.
+    this.debug.lastPause = params;
+    // A pause with no visible response reads as a hung page. Surface the
+    // stack/scopes/stepping panel alongside the Sources reveal.
+    void UI.ViewManager.ViewManager.instance().showView('mersey-debugger');
+    // Light up the STANDARD stepping actions — same buttons, same shortcuts
+    // as JS. SourcesPanel's delegates route them to Mersey while
+    // __merseyDebug.lastPause is set.
+    this.#setSteppingActionsEnabled(true);
+    const frame = params.callFrames[0];
+    const script = frame ? this.#scriptForFrame(frame.url) : undefined;
+    if (!frame || !script) {
+      return;
+    }
+    // Reveal where the user is actually working: the page's own HTML file if
+    // their breakpoints live there (its content is servable after a reload
+    // with DevTools open), else the virtual .mersey file, which always has
+    // content.
+    const workspace = Workspace.Workspace.WorkspaceImpl.instance();
+    const documentCode = workspace.uiSourceCodeForURL(script.url as Platform.DevToolsPath.UrlString);
+    const documentHasBreakpoints = documentCode !== null &&
+        Breakpoints.BreakpointManager.BreakpointManager.instance()
+            .breakpointLocationsForUISourceCode(documentCode)
+            .length > 0;
+    if (documentCode && documentHasBreakpoints) {
+      this.debug.reveals++;
+      void Common.Revealer.reveal(documentCode.uiLocation(script.startLine + frame.lineNumber, 0));
+      return;
+    }
+    const uiSourceCode = workspace.uiSourceCodeForURL(
+        this.#virtualUrlFor(script) as Platform.DevToolsPath.UrlString);
+    if (!uiSourceCode) {
+      return;
+    }
+    this.debug.reveals++;
+    void Common.Revealer.reveal(uiSourceCode.uiLocation(frame.lineNumber, 0));
+  }
+}
+
+// Meta modules evaluate before MainImpl boots, and boot REPLACES app
+// singletons — a bridge constructed at module load observes an orphan
+// TargetManager and never hears about any target (observed: construction saw
+// 0 targets, the probe later saw 2, targetAdded never fired). Late
+// initialization is the blessed hook for "run after the app is wired".
+Common.Runnable.registerLateInitializationRunnable({
+  id: 'mersey-sources-bridge',
+  async loadRunnable() {
+    return {
+      async run() {
+        new MerseySourcesBridge();
+      },
+    };
+  },
+});
