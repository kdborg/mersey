   private aiCodeCompletionProvider?: TextEditor.AiCodeCompletionProvider.AiCodeCompletionProvider;
 
+  // Mersey fork: the completion surface in Mersey mode is MERSEY's view — the
+  // session's own top-level bindings plus its prelude — and never the JS
+  // realm's. `Mersey.completions` is what the engine can actually see; it
+  // excludes window/document by construction.
+  async #merseyCompletion(context: CodeMirror.CompletionContext):
+      Promise<CodeMirror.CompletionResult|null> {
+    const word = context.matchBefore(/[A-Za-z_$][\w$]*/);
+    if (!word && !context.explicit) {
+      return null;
+    }
+    const executionContext = UI.Context.Context.instance().flavor(SDK.RuntimeModel.ExecutionContext);
+    if (!executionContext) {
