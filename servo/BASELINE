# Servo fork overlay — reconstruct on top of pinned upstream servo.
# The full Servo checkout is not stored here; only the Mersey delta in overlay/.
# See scripts/fork-overlay.sh (apply / verify / bootstrap).

upstream  https://github.com/servo/servo.git
revision  736ad1bda08c1af419aadc903e82938f8610a65d

# components/script/mersey/bridge.js is generated from the canonical
# web/mersey-bridge.js — never stored here; regenerate it after apply.
regen     "$MERSEY_REPO/servo/refresh-bridge.sh" components/script/mersey/bridge.js "$MERSEY_REPO"

# Servo builds the mersey_capi crate itself (referenced by path in Cargo.toml).
build     ./mach build --release
