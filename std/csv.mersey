// CSV — comma-separated values, parsed and serialized (RFC 4180).
//
// Pure computation: text in, a grid of strings out, and back. It handles the
// parts that trip up a naive `split(",")` — a field wrapped in double quotes
// may contain commas, line breaks, and quotes escaped by doubling (`""`).
// Everything is a string; CSV has no types, and guessing that "01" is a number
// or "true" a boolean is how a ZIP code loses its leading zero. Parse the
// strings, then interpret them yourself.
//
// Reading accepts either `\n` or `\r\n` line endings; writing emits `\r\n` (the
// spec's) and quotes a field only when it must. A trailing newline does not
// produce a spurious empty final row.

// Character codes used for scanning (comparisons read clearer as codes here).
const QUOTE: int32 = 34; // "
const COMMA: int32 = 44; // ,
const LF: int32 = 10; //    \n
const CR: int32 = 13; //    \r
// A one-character string holding a double quote, for building quoted output.
const DQ: string = "\"";

/// Parse CSV text into rows of fields.
export function parse(text: string): string[][] {
    const rows: string[][] = [];
    let row: string[] = [];
    let field: string = "";
    let inQuotes: bool = false;
    let started: bool = false; // has the current record produced anything?
    let i: int32 = 0;
    while (i < text.length) {
        const cp = text.codePointAt(i);
        const c = text.charAt(i);
        if (inQuotes) {
            if (cp == QUOTE) {
                // A doubled quote inside quotes is one literal quote.
                if (i + 1 < text.length && text.codePointAt(i + 1) == QUOTE) {
                    field = `${field}${c}`;
                    i += 2;
                    continue;
                }
                inQuotes = false;
                i += 1;
                continue;
            }
            field = `${field}${c}`;
            i += 1;
            continue;
        }
        if (cp == QUOTE) {
            inQuotes = true;
            started = true;
            i += 1;
            continue;
        }
        if (cp == COMMA) {
            row.push(field);
            field = "";
            started = true;
            i += 1;
            continue;
        }
        if (cp == LF || cp == CR) {
            row.push(field);
            field = "";
            rows.push(row);
            row = [];
            started = false;
            // Treat CRLF as a single terminator.
            if (cp == CR && i + 1 < text.length && text.codePointAt(i + 1) == LF) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        field = `${field}${c}`;
        started = true;
        i += 1;
    }
    // Flush a final record that was not terminated by a newline.
    if (started || field.length > 0 || row.length > 0) {
        row.push(field);
        rows.push(row);
    }
    return rows;
}

/// Serialize rows of fields to CSV text with `\r\n` line endings. A field is
/// quoted only if it contains a comma, quote, or line break.
export function stringify(rows: string[][]): string {
    const lines: string[] = [];
    for (const row of rows) {
        const cells: string[] = [];
        for (const field of row) {
            cells.push(quoteField(field));
        }
        lines.push(cells.join(","));
    }
    return lines.join("\r\n");
}

// ---- internals --------------------------------------------------------------

function quoteField(s: string): string {
    let needs: bool = false;
    let hasQuote: bool = false;
    for (let i: int32 = 0; i < s.length; i += 1) {
        const cp = s.codePointAt(i);
        if (cp == COMMA || cp == LF || cp == CR) {
            needs = true;
        } else if (cp == QUOTE) {
            needs = true;
            hasQuote = true;
        }
    }
    if (!needs) {
        return s;
    }
    const body = hasQuote ? doubleQuotes(s) : s;
    return `${DQ}${body}${DQ}`;
}

/// Double every quote in `s` (RFC 4180 escaping).
function doubleQuotes(s: string): string {
    let out: string = "";
    for (let i: int32 = 0; i < s.length; i += 1) {
        const c = s.charAt(i);
        if (s.codePointAt(i) == QUOTE) {
            out = `${out}${DQ}${DQ}`;
        } else {
            out = `${out}${c}`;
        }
    }
    return out;
}
