// Result<T, E> — the error convention promised by spec §1.3.
//
// This module is written in Mersey and loaded through the module graph: the
// standard library is no longer all native kernels.
//
// Use it when a failure is ordinary and the caller should decide what to do:
//
//     const parsed: Result<int32, string> = toInt("42");
//     if (parsed.isOk()) { console.log(parsed.unwrap()); }
//     console.log(parsed.unwrapOr(0));

export class Result<T, E> {
    private readonly value: T?;
    private readonly error: E?;
    private readonly ok: bool;

    // Prefer the `ok(…)` / `err(…)` constructors below.
    public constructor(ok: bool, value: T?, error: E?) {
        this.ok = ok;
        this.value = value;
        this.error = error;
    }

    public isOk(): bool { return this.ok; }
    public isErr(): bool { return !this.ok; }

    /// The value, or `null` if this is an error.
    public unwrap(): T? { return this.value; }
    /// The error, or `null` if this is a success.
    public unwrapErr(): E? { return this.error; }

    /// The value, or `fallback` when this is an error.
    public unwrapOr(fallback: T): T {
        const v = this.value;
        return this.ok && v != null ? v : fallback;
    }

    /// Transform the success value, leaving an error untouched.
    public map<U>(f: (value: T) => U): Result<U, E> {
        const v = this.value;
        if (this.ok && v != null) {
            return new Result<U, E>(true, f(v), null);
        }
        return new Result<U, E>(false, null, this.error);
    }

    /// Transform the error, leaving a success untouched.
    public mapErr<F>(f: (error: E) => F): Result<T, F> {
        const e = this.error;
        if (!this.ok && e != null) {
            return new Result<T, F>(false, null, f(e));
        }
        return new Result<T, F>(true, this.value, null);
    }
}

export function ok<T, E>(value: T): Result<T, E> {
    return new Result<T, E>(true, value, null);
}

export function err<T, E>(error: E): Result<T, E> {
    return new Result<T, E>(false, null, error);
}
