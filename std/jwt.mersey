// JSON Web Tokens — HS256 sign and verify (RFC 7519 / 7515).
//
// A JWT is `header.payload.signature`, each part base64url without padding. This
// signs with HMAC-SHA-256 (`std:hash`) and the `{"alg":"HS256","typ":"JWT"}`
// header, and verifies the signature before handing back the payload.
//
// It works in *strings*, not objects: `sign` takes the claims already as JSON
// text and `verify` returns the payload as JSON text, which you parse with
// `std:json`. That keeps the module about the one thing that must be exactly
// right — the signature — and leaves the claim shape to you. Only HS256 is
// supported; `alg: none` and the asymmetric algorithms are deliberately absent,
// because "accept whatever alg the token claims" is the classic JWT vulnerability.
//
// `verify` returns null on any failure — malformed token, wrong signature — and
// never throws, so a bad token from the network is a value you branch on, not
// an exception. It does NOT check `exp`/`nbf`: expiry is a claim, so read it
// from the parsed payload yourself.

import { hash } from "std:hash";
import { bytes } from "std:bytes";

// The fixed HS256 header, pre-encoded: base64url of {"alg":"HS256","typ":"JWT"}.
const HEADER: string = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9";
const B64URL: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

/// Sign a claims JSON string, returning the `header.payload.signature` token.
export function sign(payloadJson: string, secret: string): string {
    const payload = b64urlEncode(bytes.encodeUtf8(payloadJson));
    const signingInput = `${HEADER}.${payload}`;
    const sig = signature(signingInput, secret);
    return `${signingInput}.${sig}`;
}

/// Verify a token's signature with `secret` and return its payload as JSON text,
/// or null if the token is malformed or the signature does not match.
export function verify(token: string, secret: string): string? {
    const parts = token.split(".");
    if (parts.length != 3) {
        return null;
    }
    const signingInput = `${parts[0]}.${parts[1]}`;
    const expected = signature(signingInput, secret);
    if (!constEq(expected, parts[2])) {
        return null;
    }
    return decodePart(parts[1]);
}

/// The payload JSON of a token WITHOUT verifying its signature — for reading a
/// claim (an issuer, say) to decide which key to verify with. Never trust what
/// this returns until `verify` has accepted the token. Null if malformed.
export function decode(token: string): string? {
    const parts = token.split(".");
    if (parts.length != 3) {
        return null;
    }
    return decodePart(parts[1]);
}

// ---- internals --------------------------------------------------------------

function signature(signingInput: string, secret: string): string {
    const mac = hash.hmacSha256(bytes.encodeUtf8(secret), bytes.encodeUtf8(signingInput));
    return b64urlEncode(mac);
}

function decodePart(part: string): string? {
    const raw = b64urlDecode(part);
    if (raw == null) {
        return null;
    }
    return bytes.decodeUtf8(raw);
}

/// Compare two strings without an early exit on the first difference — a token's
/// signature check should not leak where it diverged. (A tree-walker has bigger
/// timing tells than this, but the habit is the point.)
function constEq(a: string, b: string): bool {
    if (a.length != b.length) {
        return false;
    }
    let same: bool = true;
    for (let i: int32 = 0; i < a.length; i += 1) {
        if (a.codePointAt(i) != b.codePointAt(i)) {
            same = false;
        }
    }
    return same;
}

// base64url (RFC 4648 §5) without padding, on integer arithmetic.
function b64urlEncode(data: Bytes): string {
    let out: string = "";
    const n = data.length;
    let i: int32 = 0;
    while (i + 3 <= n) {
        const b0 = data[i];
        const b1 = data[i + 1];
        const b2 = data[i + 2];
        out = `${out}${B64URL.charAt(b0 / 4)}${B64URL.charAt((b0 % 4) * 16 + b1 / 16)}${B64URL.charAt((b1 % 16) * 4 + b2 / 64)}${B64URL.charAt(b2 % 64)}`;
        i += 3;
    }
    const rem = n - i;
    if (rem == 1) {
        const b0 = data[i];
        out = `${out}${B64URL.charAt(b0 / 4)}${B64URL.charAt((b0 % 4) * 16)}`;
    } else if (rem == 2) {
        const b0 = data[i];
        const b1 = data[i + 1];
        out = `${out}${B64URL.charAt(b0 / 4)}${B64URL.charAt((b0 % 4) * 16 + b1 / 16)}${B64URL.charAt((b1 % 16) * 4)}`;
    }
    return out;
}

function b64urlDecode(text: string): Bytes? {
    const vals: int32[] = [];
    for (let i: int32 = 0; i < text.length; i += 1) {
        const v = B64URL.indexOf(text.charAt(i));
        if (v < 0) {
            return null; // JWT parts carry no padding or whitespace
        }
        vals.push(v);
    }
    const groups = vals.length / 4;
    const rem = vals.length % 4;
    if (rem == 1) {
        return null;
    }
    let outLen = groups * 3;
    if (rem == 2) {
        outLen += 1;
    } else if (rem == 3) {
        outLen += 2;
    }
    const out = bytes.alloc(outLen);
    let oi: int32 = 0;
    let vi: int32 = 0;
    for (let g: int32 = 0; g < groups; g += 1) {
        const c0 = vals[vi];
        const c1 = vals[vi + 1];
        const c2 = vals[vi + 2];
        const c3 = vals[vi + 3];
        out[oi] = c0 * 4 + c1 / 16;
        out[oi + 1] = (c1 % 16) * 16 + c2 / 4;
        out[oi + 2] = (c2 % 4) * 64 + c3;
        oi += 3;
        vi += 4;
    }
    if (rem == 2) {
        const c0 = vals[vi];
        const c1 = vals[vi + 1];
        out[oi] = c0 * 4 + c1 / 16;
    } else if (rem == 3) {
        const c0 = vals[vi];
        const c1 = vals[vi + 1];
        const c2 = vals[vi + 2];
        out[oi] = c0 * 4 + c1 / 16;
        out[oi + 1] = (c1 % 16) * 16 + c2 / 4;
    }
    return out;
}
