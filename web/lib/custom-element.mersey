// Custom elements as host-backed classes.
//
// `CustomElement extends HTMLElement`, so a subclass instance *is* the DOM
// element: `this.textContent = …`, `this.addEventListener(…)`, `this.append(…)`
// all work directly, and `this` can be passed anywhere an `Element` is
// expected. The browser constructs the element, so `defineElement` attaches
// the instance to it rather than constructing a host object itself.
import { merseyDefineElement, attach } from "browser:dom";

export abstract class CustomElement extends HTMLElement {
    /// Attributes to observe; changes call `attributeChanged`.
    public observedAttributes(): string[] { return []; }

    /// The element entered the document.
    public connected(): void {}
    /// The element left the document.
    public disconnected(): void {}
    /// An observed attribute changed.
    public attributeChanged(name: string, oldValue: string, newValue: string): void {}
}

/// Register `tag`, backed by a fresh instance of the class `create()` returns
/// — one instance per element, and that instance *is* the element.
export function defineElement(tag: string, create: () => CustomElement): void {
    const instances = new Map<Element, CustomElement>();

    // The browser fires `attributeChangedCallback` before `connectedCallback`
    // for attributes present at upgrade, so bind on whichever arrives first.
    const instanceFor = (el: Element): CustomElement => {
        const existing = instances.get(el);
        if (existing != null) {
            return existing;
        }
        // `attach` returns the welded instance: on the engine that is the
        // same object (now host-backed); on the transpiled path it is the
        // element itself, carrying the class's methods and fields.
        const created = attach(create(), el) as CustomElement;
        instances.set(el, created);
        return created;
    };

    merseyDefineElement(tag, {
        connected: (el: Element) => {
            instanceFor(el).connected();
        },
        disconnected: (el: Element) => {
            const instance = instances.get(el);
            if (instance != null) {
                instance.disconnected();
                instances.remove(el);
            }
        },
        attributeChanged: (el: Element, name: string, oldValue: string, newValue: string) => {
            instanceFor(el).attributeChanged(name, oldValue, newValue);
        },
        observed: create().observedAttributes(),
    });
}
