# Firefox/Gecko fork overlay — reconstruct on top of pinned upstream Firefox.
# The full checkout is not stored here; only the ~45-file Mersey glue delta in
# overlay/. The Mersey engine's vendored Rust dependencies (Cranelift & co.,
# ~1500 crate files) are NOT stored — they are regenerated by `mach vendor rust`
# from the pinned Cargo.lock. See scripts/fork-overlay.sh (apply/verify/bootstrap).

upstream  https://github.com/mozilla-firefox/firefox.git
revision  5555170839c3b7a3f7731781d7cd077988325efd

# dom/mersey/include/mersey.h is the canonical ABI header copied in — regenerate.
regen     cp "$MERSEY_REPO/crates/mersey_capi/include/mersey.h" dom/mersey/include/mersey.h
# Regenerate the vendored Rust crate tree (Cranelift &co.) from the pinned
# Cargo.lock. BOOTSTRAP-only: the Mersey engine itself is a path dep (dom/mersey/
# rust references mersey_capi by relative path), so an incremental `apply` on an
# already-vendored checkout doesn't need it — and it fails on `mach cargo vet`
# for an unaudited crate. So it lives with `build` (run only by a fresh
# `bootstrap`, before ./mach build), not `regen` (run by every `apply`).
build     ./mach vendor rust --ignore-modified
build     ./mach build
