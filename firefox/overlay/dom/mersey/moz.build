EXPORTS.mozilla.dom += [
    "MerseyBridgeSource.h",
    "MerseyScriptRunner.h",
]

# The engine's C ABI header, as the Rust crate publishes it. Kept in sync by
# dom/mersey/refresh.sh, which also rebuilds the crate.
EXPORTS += [
    "include/mersey.h",
]

UNIFIED_SOURCES += [
    "MerseyScriptRunner.cpp",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
