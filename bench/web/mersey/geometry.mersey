// Web-platform workload: Geometry interfaces. Each iteration builds a
// DOMMatrix, chains a translate and a scale (two constructions + two
// multiplies in the engine's host), and reads three components back.
import { console } from "std:console";
import { time } from "std:time";
import { DOMMatrix } from "browser:dom";

const N: int32 = 10000;

function work(n: int32): int32 {
    let sum = 0;
    let i = 0;
    while (i < n) {
        const m = new DOMMatrix();
        const t = m.translate((i % 10) as float64, 3.0).scale(2.0);
        sum = sum + (t.m41 as int32) + (t.m42 as int32) + (t.a as int32);
        i += 1;
    }
    return sum;
}

work(1000);
const t0 = time.monotonic();
const c = work(N);
const t1 = time.monotonic();
console.log(`RESULT geometry ${t1 - t0} ${c}`);
