// Web-platform workload: Compression Streams. Each iteration pipes a string
// through gzip and back (CompressionStream → DecompressionStream) and reads
// the roundtripped text — compressed bytes differ across engines, the
// roundtrip does not, so the checksum stays comparable.
import { console } from "std:console";
import { time } from "std:time";
import { CompressionStream, DecompressionStream, Response } from "browser:dom";

const N: int32 = 200;

let sum = 0;
let i = 0;
let t0 = 0.0;

function step(): void {
    if (i >= N) {
        const t1 = time.monotonic();
        console.log(`RESULT compression ${t1 - t0} ${sum}`);
        return;
    }
    const data = `payload-${i} zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz`;
    const cs = new CompressionStream("gzip");
    const ds = new DecompressionStream("gzip");
    const src = new Response(data).body as ReadableStream;
    const out = src.pipeThrough({ readable: cs.readable, writable: cs.writable }).pipeThrough({ readable: ds.readable, writable: ds.writable });
    new Response(out).text().then((t: string) => {
        sum = sum + t.length;
        i += 1;
        step();
    });
}

t0 = time.monotonic();
step();
