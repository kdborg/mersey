// CLI twin of bench/web/mersey/encoding.mersey, using std:bytes instead of the
// browser's TextEncoder/TextDecoder — so the Mersey backend can run it. UTF-8 is
// UTF-8, so the checksum is identical to the browser encoding leg (437780).
import { console } from "std:console";
import { time } from "std:time";
import { bytes } from "std:bytes";

const N: int32 = 10000;

function work(n: int32): int32 {
    let sum = 0;
    let i = 0;
    while (i < n) {
        const b = bytes.encodeUtf8(`payload ${i} — encdec`);
        sum = sum + b.length;
        const str = bytes.decodeUtf8(b);
        if (str != null) {
            sum = sum + str.length;
        }
        i += 1;
    }
    return sum;
}

work(1000);
const t0 = time.monotonic();
const c = work(N);
const t1 = time.monotonic();
console.log(`RESULT encoding ${t1 - t0} ${c}`);
