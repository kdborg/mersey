// CLI twin of bench/web/mersey/crypto.mersey, using std:random instead of the
// browser's crypto.getRandomValues — both reach a CSPRNG. The checksum is only
// the buffer length summed (the random bytes never enter it), so it is identical
// to the browser crypto leg (320000). Requires the `random` capability.
//
// The buffer is hoisted and filled in place, which is what the JS twin does with
// `crypto.getRandomValues(buf)` and what the browser Mersey twin already did.
// This one used to call `random.bytes(16)` inside the loop — allocating a fresh
// buffer per iteration where the twin allocated none — so it was measuring an
// allocation the other side never made.
import { console } from "std:console";
import { time } from "std:time";
import { bytes } from "std:bytes";
import { random } from "std:random";

const N: int32 = 20000;
const buf = bytes.alloc(16);

function work(n: int32): int32 {
    let sum = 0;
    let i = 0;
    while (i < n) {
        random.fill(buf);
        sum = sum + buf.length;
        i += 1;
    }
    return sum;
}

work(1000);
const t0 = time.monotonic();
const c = work(N);
const t1 = time.monotonic();
console.log(`RESULT crypto ${t1 - t0} ${c}`);
