// CLI twin of bench/web/mersey/crypto.mersey, using std:random instead of the
// browser's crypto.getRandomValues — both reach a CSPRNG. The checksum is only
// the buffer length summed (the random bytes never enter it), so it is identical
// to the browser crypto leg (320000). Requires the `random` capability.
import { console } from "std:console";
import { time } from "std:time";
import { random } from "std:random";

const N: int32 = 20000;

function work(n: int32): int32 {
    let sum = 0;
    let i = 0;
    while (i < n) {
        const b = random.bytes(16);
        sum = sum + b.length;
        i += 1;
    }
    return sum;
}

work(1000);
const t0 = time.monotonic();
const c = work(N);
const t1 = time.monotonic();
console.log(`RESULT crypto ${t1 - t0} ${c}`);
