/target
**/*.rs.bk
/web/mersey_wasm.wasm
/native/host_demo
mersey.lock

# `mersey doc` output: generated, never edited by hand.
site/
test-dumps/

# Local build logs (fork rebuilds); never committed
.build-logs/

# The fuzzer writes the case it is currently running here, so a crash leaves the
# reproducer on disk. CI runs the fuzzers on every push, so this file exists in
# any tree that has run them — and it is exactly the sort of thing a `git add -A`
# sweeps up by accident.
fuzz-current.mersey

# Per-machine Claude Code state (tool permissions, local settings). Anything in
# here worth sharing goes in the checked-in CLAUDE.md instead.
.claude/

# Claude Code session transcripts, which land in the working directory when a
# session is exported. Same `git add -A` hazard as the fuzzer's reproducer.
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# WasmGC probes: assembled from the .wat by bench/wasmgc/build.sh, like every
# other generated artifact here — the source is the .wat.
bench/wasmgc/probes/*.wasm
