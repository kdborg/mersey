// The language, tested in itself.
//
// `mersey test` runs every *.test.mersey; this file is also a plain module, so
// `mersey run tests/mersey/language.test.mersey` does exactly the same thing.
// Declarations are module-level (§6.7), so the classes under test live here
// rather than inside the cases.

import { test, assert, refute, assertThrows } from "std:test";

class Counter {
    private n: int32 = 0;
    public bump(): int32 {
        this.n += 1;
        return this.n;
    }
}

class Safe {
    private secret: int32 = 42;
    public reveal(): int32 {
        return this.secret;
    }
}

class Custom extends Error {
    public constructor(m: string) {
        super(m);
    }
}

function halve(x: float64): float64 {
    return x / 2;
}

function counter(start: int32, to: int32): int32 {
    let i = start;
    while (i <= to) {
        yield i;
        i += 1;
    }
}

test("C-style coercion widens, and integer division truncates", () => {
    const a: int32 = 7;
    const b: int64 = a; // widening is implicit (§3.3)
    assert(b == 7, "int32 widened to int64");
    assert(7 / 2 == 3, "integer division truncates");
    assert(7.0 / 2.0 == 3.5, "float division does not");
});

test("integers wrap at their declared width, not at 2^53", () => {
    const big: int32 = 2147483647;
    assert(big + 1 == -2147483648, "int32 wraps");
    // The *declared* width, not the width the value happened to be stored at.
    // This is the case the engine used to get wrong: the literal was an int32,
    // nothing converted it, and an int64 wrapped at 32 bits.
    const wide: int64 = 2147483647;
    assert(wide + 1 == 2147483648, "int64 does not wrap here");
    const u: uint32 = 4294967295;
    assert(u + 1 == 0, "uint32 wraps at 32 bits");
});

test("widening is real at run time, not just in the type checker", () => {
    // `7` is an int32 literal. Everything below declares a float64, so what is
    // stored is a float64 — and float division is what these are asking for.
    const init: float64 = 7;
    assert(init / 2 == 3.5, "initializer widens");

    const xs: float64[] = [7];
    assert(xs[0] / 2 == 3.5, "array element widens");

    assert(halve(7) == 3.5, "argument widens");

    let acc: float64 = 0.0;
    acc += 7;
    assert(acc / 2 == 3.5, "compound assignment widens its operand");

    // And an int32 stays an int32: widening is not rounding.
    const n: int32 = 7;
    assert(n / 2 == 3, "integer division still truncates");
});

test("strings are UTF-16, and every index speaks code units", () => {
    const s = "héllo";
    assert(s.length == 5, "five code units");

    // The case that tells the two apart: an emoji is one code *point* and two
    // code *units*, and the engine counts units — the same answer JS gives.
    // This test used to say "code points, not UTF-16 units" and assert against a
    // pure-BMP string, where the two agree and so it could not tell.
    const e = "😀a.b";
    assert(e.length == 5, "the emoji is two units, not one");

    // Searching returns a code-unit index, so it composes with `slice` and
    // `charAt`. It did not: `indexOf` counted code points while `length` counted
    // units, so this `slice` cut the surrogate pair in half and returned a lone
    // surrogate followed by the rest.
    assert(e.indexOf("a") == 2, "indexOf is a code-unit index");
    assert(e.indexOf(".") == 3, "…and keeps counting in units");
    assert(e.lastIndexOf("b") == 4, "as does lastIndexOf");
    assert(e.slice(e.indexOf("a")) == "a.b", "so the two compose");

    // Missing is -1, an empty needle matches at 0, and the ends are exact.
    assert(e.indexOf("zz") == -1, "absent is -1");
    assert(e.indexOf("") == 0, "an empty needle matches at the start");
    assert(e.startsWith("😀"), "startsWith compares units");
    assert(e.endsWith(".b"), "endsWith too");
    assert(!e.startsWith("a"), "and does not match past the start");
});

test("classes are sealed: no prototypes, fixed layout", () => {
    const c = new Counter();
    c.bump();
    assert(c.bump() == 2, "per-instance state");
});

test("private members are private", () => {
    assert(new Safe().reveal() == 42, "reachable from inside");
    // `new Safe().secret` does not compile — that is the point, and the
    // checker enforces it (E0404) rather than the runtime.
});

test("null is not a value you can ignore", () => {
    const xs: int32[] = [1, 2, 3];
    const found = xs.find((x: int32) => x > 10); // int32?
    assert(found == null, "no match yields null");
});

test("errors carry a message through super()", () => {
    try {
        throw new Custom("carried");
    } catch (e: Error) {
        assert(e.message == "carried", "message survived the super() call");
    }
});

test("only Errors can be thrown", () => {
    assertThrows(() => {
        throw new Error("x");
    }, "an Error throws");
    // `throw 42` does not compile (E0412).
});

test("generators suspend and resume", () => {
    let total: int32 = 0;
    for (const n of counter(1, 5)) {
        total += n;
    }
    assert(total == 15, "1+2+3+4+5");
});

test("closures capture the binding, and each iteration gets its own", () => {
    const fns: (() => int32)[] = [];
    for (let i = 0; i < 3; i++) {
        fns.push(() => i);
    }
    assert(fns[0]() == 0 && fns[2]() == 2, "each closure kept its own i");
});

test("refute and assertThrows do what they say", () => {
    refute(false, "false is not true");
    assertThrows(() => {
        assert(false, "inner");
    }, "a failed assert throws");
});

// `trim`, `trimStart`, `trimEnd` and `replace`/`replaceAll` answer from the code
// units now, above the UTF-8 transcode rather than below it. Trimming two spaces
// used to pay for a whole UTF-8 copy of the receiver (7.0x node, 2.14x once
// moved); `replace` converted the receiver, the needle *and* the replacement
// (6.4x, 1.54x).
//
// These pin the answers, because "faster" is only interesting if it is the same.
// The whitespace set is the one `char::is_whitespace` accepts — all of it in the
// BMP, which is what makes a per-unit test equivalent rather than approximate.
test("trim reads the ends without transcoding the middle", () => {
    assert("  x  ".trim() == "x", "both ends");
    assert("  x  ".trimStart() == "x  ", "leading only");
    assert("  x  ".trimEnd() == "  x", "trailing only");
    assert("x".trim() == "x", "nothing to do");
    assert("".trim() == "", "an empty string");
    assert("     ".trim() == "", "all whitespace trims to nothing");
    assert("     ".trimStart() == "", "…from the front");
    assert("     ".trimEnd() == "", "…and from the back");
    assert("\t\n\r x \t\n\r".trim() == "x", "tabs, newlines and returns");
    // Non-ASCII whitespace: NBSP and IDEOGRAPHIC SPACE are both `White_Space`.
    assert("\u{00A0}x\u{3000}".trim() == "x", "non-ASCII whitespace counts");
    // A surrogate pair is never whitespace and must survive at either end.
    assert("\u{1F600}".trim() == "\u{1F600}", "a non-BMP character is kept");
    assert(" \u{1F600} ".trim().length == 2, "…and keeps both its units");
});

test("replace works in code units, and only where that means the same thing", () => {
    assert("a-b-c".replace("-", "+") == "a+b-c", "replace takes the first only");
    assert("a-b-c".replaceAll("-", "+") == "a+b+c", "replaceAll takes them all");
    assert("abc".replace("z", "!") == "abc", "a needle that is not there");
    assert("aaa".replaceAll("aa", "b") == "ba", "matches do not overlap");
    assert("-x".replace("-", "") == "x", "an empty replacement deletes");
    assert("x-".replaceAll("-", "") == "x", "…at the end too");
    assert("ab".replaceAll("ab", "abab") == "abab", "the replacement is not rescanned");
    assert("aXbXc".replaceAll("X", "\u{1F600}").length == 3 + 2 + 2, "a non-BMP replacement");
    // An empty needle keeps the old behaviour deliberately: it inserts between
    // every *character*, which is a different set of positions from every unit.
    assert("ab".replaceAll("", "-") == "-a-b-", "an empty needle still splits");
});

// `repeat`, `padStart` and `padEnd` answer from the code units too. Padding was
// the worst of the three and for two reasons at once: it transcoded a receiver
// it then never read, and it built the answer with `insert` into a vector that
// began as the receiver, shifting everything after the cursor on every unit —
// quadratic in the padding. 4.69x once written in one pass.
//
// `repeat` needed a second attempt: pushing the receiver n times was 24% slower
// than the UTF-8 round trip it replaced, because `str::repeat` copies by
// doubling. Copying from what is already written does the same and is 1.34x.
test("repeat and pad answer in code units", () => {
    assert("ab".repeat(0) == "", "zero repeats to nothing");
    assert("ab".repeat(1) == "ab", "one is the string itself");
    assert("ab".repeat(3) == "ababab", "the ordinary case");
    assert("".repeat(5) == "", "an empty string stays empty");
    // Doubling has to land on an odd count as exactly as an even one.
    assert("xyz".repeat(7).length == 21, "an odd count");
    assert("\u{1F600}".repeat(3).length == 6, "units, not characters");

    assert("abc".padStart(6, "0") == "000abc", "pad on the left");
    assert("abc".padEnd(6, "0") == "abc000", "pad on the right");
    assert("abc".padStart(3, "0") == "abc", "already wide enough");
    assert("abc".padStart(2, "0") == "abc", "narrower than the string");
    assert("abc".padStart(6) == "   abc", "the default pad is a space");
    // A multi-unit pad cycles and is cut off wherever the width lands.
    assert("x".padStart(6, "ab") == "ababax", "the pad repeats");
    assert("x".padEnd(6, "ab") == "xababa", "…on the right too");
    assert("x".padStart(4, "abcdefg") == "abcx", "and is truncated");
    // The width is counted in code units, which is what `length` reports.
    assert("x".padStart(5, "\u{1F600}").length == 5, "a non-BMP pad fills by unit");
});
