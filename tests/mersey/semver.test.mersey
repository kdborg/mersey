// std:semver, tested in Mersey. `mersey test` runs this; `mersey run` on the
// same file does exactly the same thing (it is an ordinary module).

import { test, assert, refute } from "std:test";
import { Version, parse, valid, compare, satisfies } from "std:semver";

// Strict precedence "<" over version strings, for the ordering chains below.
function before(a: string, b: string): bool {
    const c = compare(a, b);
    return c != null && c < 0;
}

// `satisfies` with the null (unparseable-version) case folded to false.
function sat(v: string, r: string): bool {
    const s = satisfies(v, r);
    return s != null && s;
}

test("valid accepts well-formed versions", () => {
    assert(valid("0.0.0"), "0.0.0");
    assert(valid("1.2.3"), "1.2.3");
    assert(valid("v1.2.3"), "leading v tolerated");
    assert(valid("10.20.30"), "multi-digit");
    assert(valid("1.2.3-0"), "single zero prerelease");
    assert(valid("1.2.3-alpha.1"), "dotted prerelease");
    assert(valid("1.2.3-x-y-z.0"), "hyphens inside a prerelease identifier");
    assert(valid("1.2.3+build.001"), "build metadata may have leading zeros");
    assert(valid("1.2.3-beta+exp.sha.5114f85"), "prerelease and build together");
});

test("valid rejects malformed versions", () => {
    refute(valid("1.2"), "needs three parts");
    refute(valid("1.2.3.4"), "no fourth part");
    refute(valid("01.2.3"), "no leading zero in the core");
    refute(valid("1.2.3-01"), "no leading zero in a numeric prerelease id");
    refute(valid("1.2.3-"), "empty prerelease");
    refute(valid("1.2.3+"), "empty build");
    refute(valid("1.2.3-al pha"), "space is not an identifier char");
    refute(valid("1.2.x"), "non-numeric core");
    refute(valid(""), "empty string");
});

test("parse exposes the parts and round-trips through toString", () => {
    const v = parse("1.2.3-rc.1+build.5");
    assert(v != null, "parses");
    if (v != null) {
        assert(v.major == 1 && v.minor == 2 && v.patch == 3, "numeric core");
        assert(v.prerelease == "rc.1", "prerelease");
        assert(v.build == "build.5", "build");
        assert(v.core() == "1.2.3", "core() omits pre/build");
        assert(v.toString() == "1.2.3-rc.1+build.5", "round-trips");
    }
});

test("numeric core compares field by field", () => {
    assert(before("1.0.0", "2.0.0"), "major");
    assert(before("2.0.0", "2.1.0"), "minor");
    assert(before("2.1.0", "2.1.1"), "patch");
    const c = compare("1.2.3", "1.2.3");
    assert(c != null && c == 0, "equal cores are equal");
});

test("prerelease precedence chain (spec §11 example)", () => {
    const order: string[] = [
        "1.0.0-alpha",
        "1.0.0-alpha.1",
        "1.0.0-alpha.beta",
        "1.0.0-beta",
        "1.0.0-beta.2",
        "1.0.0-beta.11",
        "1.0.0-rc.1",
        "1.0.0",
    ];
    for (let i: int32 = 0; i < order.length - 1; i += 1) {
        assert(before(order[i], order[i + 1]),
               `${order[i]} should precede ${order[i + 1]}`);
    }
});

test("numeric prerelease identifiers compare numerically, not as text", () => {
    // The classic trap: as text "11" < "2", but as numbers 2 < 11.
    assert(before("1.0.0-beta.2", "1.0.0-beta.11"), "beta.2 < beta.11");
});

test("build metadata is ignored in comparison (§10)", () => {
    const c = compare("1.0.0+a", "1.0.0+b");
    assert(c != null && c == 0, "build does not affect precedence");
    const v = parse("1.0.0+xyz");
    const w = parse("1.0.0");
    assert(v != null && w != null, "both parse");
    if (v != null && w != null) {
        assert(v.equals(w), "equal precedence despite build");
    }
});

test("increments produce clean releases", () => {
    const v = parse("1.2.3-rc.1+meta");
    assert(v != null, "parses");
    if (v != null) {
        assert(v.nextMajor().toString() == "2.0.0", "nextMajor");
        assert(v.nextMinor().toString() == "1.3.0", "nextMinor");
        assert(v.nextPatch().toString() == "1.2.4", "nextPatch");
    }
});

test("satisfies: caret pins the left-most non-zero part", () => {
    assert(sat("1.2.3", "^1.2.0"), "1.2.3 in ^1.2.0");
    assert(sat("1.9.9", "^1.2.0"), "1.9.9 in ^1.2.0");
    refute(sat("2.0.0", "^1.2.0"), "2.0.0 out of ^1.2.0");
    assert(sat("0.2.9", "^0.2.3"), "0.2.9 in ^0.2.3");
    refute(sat("0.3.0", "^0.2.3"), "0.3.0 out of ^0.2.3");
    assert(sat("0.0.3", "^0.0.3"), "0.0.3 in ^0.0.3");
    refute(sat("0.0.4", "^0.0.3"), "^0.0.x pins the patch");
});

test("satisfies: tilde pins the minor", () => {
    assert(sat("1.2.9", "~1.2.3"), "1.2.9 in ~1.2.3");
    refute(sat("1.3.0", "~1.2.3"), "1.3.0 out of ~1.2.3");
    refute(sat("1.2.2", "~1.2.3"), "below the base");
});

test("satisfies: comparators, exact, and wildcard", () => {
    assert(sat("1.2.3", ">=1.2.3"), ">= inclusive");
    refute(sat("1.2.3", ">1.2.3"), "> exclusive");
    assert(sat("1.2.3", "<=1.2.3"), "<= inclusive");
    refute(sat("1.2.3", "<1.2.3"), "< exclusive");
    assert(sat("1.2.3", "=1.2.3"), "= exact");
    assert(sat("1.2.3", "1.2.3"), "bare is exact");
    refute(sat("1.2.4", "1.2.3"), "bare exact rejects a different patch");
    assert(sat("9.9.9", "*"), "* matches anything");
});

test("module functions guard the non-version case", () => {
    assert(compare("nope", "1.0.0") == null, "compare on a bad version is null");
    assert(satisfies("nope", "^1.0.0") == null, "satisfies on a bad version is null");
    refute(sat("1.0.0", "not-a-range"), "a malformed range is not satisfied");
});
