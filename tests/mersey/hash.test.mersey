// std:hash, tested in Mersey against the SHA-256 (FIPS 180-4) vectors.

import { test, assert } from "std:test";
import { hash } from "std:hash";
import { bytes } from "std:bytes";
import { encode } from "std:hex";

function sha256hex(s: string): string {
    return encode(hash.sha256(bytes.encodeUtf8(s)));
}

test("sha256 matches the known vectors", () => {
    assert(sha256hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
           "empty string");
    assert(sha256hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
           "abc");
    assert(sha256hex("The quick brown fox jumps over the lazy dog") ==
           "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592", "fox");
});

test("the digest is 32 bytes and is deterministic", () => {
    const a = hash.sha256(bytes.encodeUtf8("session-token"));
    const b = hash.sha256(bytes.encodeUtf8("session-token"));
    assert(a.length == 32, "256 bits");
    assert(encode(a) == encode(b), "same input, same digest");
});

test("hmacSha256 matches the RFC 4231 vectors", () => {
    // Test case 1: a 20-byte key of 0x0b, message "Hi There".
    const key1 = bytes.alloc(20);
    bytes.fill(key1, 11); // 0x0b
    const mac1 = encode(hash.hmacSha256(key1, bytes.encodeUtf8("Hi There")));
    assert(mac1 == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", mac1);

    // Test case 2: key "Jefe", message "what do ya want for nothing?".
    const mac2 = encode(hash.hmacSha256(bytes.encodeUtf8("Jefe"),
                                        bytes.encodeUtf8("what do ya want for nothing?")));
    assert(mac2 == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", mac2);
});

test("hmacSha256 depends on the key", () => {
    const data = bytes.encodeUtf8("same message");
    const a = encode(hash.hmacSha256(bytes.encodeUtf8("k1"), data));
    const b = encode(hash.hmacSha256(bytes.encodeUtf8("k2"), data));
    assert(a != b, "different keys, different MACs");
});
