import { console } from "std:console";
import { regex } from "std:regex";
import { parse } from "std:parse";
import { time } from "std:time";
import { Result, ok, err } from "std:result";   // written in Mersey itself

// ---- Regular expressions (code-point based, §3.4)
const email = regex.compile("(\\w+)@(\\w+)\\.(com|org)");
console.log(email.test("write to ada@example.com now"));
const hit = email.find("write to ada@example.com now");
if (hit != null) {
    console.log(hit.text, hit.start, hit.end, hit.groups);
}
const words = regex.compile("\\w+");
console.log(words.findAll("one two three").map(m => m.text));
console.log(regex.compile("\\s+").split("a  b\tc"));
console.log(regex.compile("[aeiou]").replaceAll("banana", "*"));
console.log(regex.compile("^h", "i").test("Hello"));

// ---- Number parsing (null on failure, not exceptions — §1.3)
console.log(parse.int32("42"), parse.int32("ff", 16), parse.int32("oops"));
console.log(parse.float64("2.5"), parse.float64("nope"));
console.log(parse.bigint("123456789012345678901234567890"));
console.log(parse.bigdec("19.99"));

// ---- Dates
const stamp = time.fromParts({ year: 2026, month: 7, day: 12, hour: 15,
                               minute: 30, second: 5, millis: 0, weekday: 0 });
const p = time.parts(stamp);
console.log(`${p.year}-${p.month}-${p.day} ${p.hour}:${p.minute}:${p.second} weekday=${p.weekday}`);
console.log(time.parts(0.0).year, time.parts(0.0).weekday);   // 1970-01-01 was a Thursday (4)

// ---- Result<T, E>, self-hosted in Mersey
function toInt(text: string): Result<int32, string> {
    const v = parse.int32(text);
    return v != null ? ok(v) : err(`not a number: ${text}`);
}
const good = toInt("7");
const bad = toInt("seven");
console.log(good.isOk(), good.unwrap(), good.unwrapOr(0));
console.log(bad.isErr(), bad.unwrapErr(), bad.unwrapOr(-1));
console.log(good.map(v => v * 6).unwrapOr(0));
console.log(bad.mapErr(e => e.length).unwrapErr());
