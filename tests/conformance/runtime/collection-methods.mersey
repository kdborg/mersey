import { console } from "std:console";

// §1.3: mutation is always explicit in the name, and mutators return void. So
// there is no `sort`/`reverse` (they are `sortInPlace`/`toSorted`), no
// `includes` (it is `contains`), and JS's `unshift`/`shift`/`splice` are spelled
// as what they do.

const xs: int32[] = [10, 20, 30, 20];

// `xs[i]` is a `T`. `xs.at(i)` is a `T?` — it admits it can miss, and counts
// from the end for a negative index.
console.log(xs.at(0), xs.at(-1), xs.at(99));
console.log(xs.indexOf(20), xs.lastIndexOf(20));

xs.insertAt(0, 5);              // JS `unshift`
console.log(xs.join(","));
const first = xs.removeAt(0);   // JS `shift`
const middle = xs.removeAt(1);  // JS `splice(1, 1)`
console.log(first, middle, xs.join(","));

const nested: int32[][] = [[1, 2], [3], [4, 5]];
console.log(nested.flat().join("-"));

const grid: int32[] = [1, 2, 3];
grid.fillInPlace(0);
console.log(grid.join(","));

// Strings are sequences of code points, so `s[i]` is a `char` and every index
// here counts code points, not bytes.
const s: string = "  héllo  ";
console.log(`[${s.trimStart()}]`, `[${s.trimEnd()}]`);
console.log("banana".lastIndexOf("an"), "héllo".at(-1), "abc".at(9));

// `substring` clamps *and swaps* its bounds; `slice` only clamps, and yields ""
// when they are the wrong way round. That difference is the reason both exist
// rather than one being an alias of the other.
console.log(s.substring(3, 5), s.substring(5, 3), s.slice(5, 3) == "");
console.log("héllo".substring(-5, 99));

console.log("a".concat("b", "c"));

// `charAt` is the JS-shaped one: a one-code-point *string*, empty out of range.
// `codePointAt` gives the number, and `null` out of range — there is no
// `undefined` here to return instead (§3.2). `s[i]` and `s.at(i)` give a `char`,
// which is usually what you actually want.
const word: string = "héllo";
console.log(`[${word.charAt(1)}]`, `[${word.charAt(99)}]`);
console.log(word.codePointAt(1), word.codePointAt(99));
console.log(word.length, word.charAt(1) == "é", word.codePointAt(1) == 233);
