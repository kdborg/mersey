import { console } from "std:console";
import { math } from "std:math";
import { format } from "std:format";
import { fs } from "std:fs";
import { env } from "std:env";
import { caps } from "std:caps";

console.log(math.abs(-42), math.abs(-2.5), math.min(3, 1, 2), math.max(3, 1, 2));
console.log(math.floor(2.7), math.ceil(2.1), math.sqrt(144.0), math.pow(2.0, 10.0));
console.log(format.fixed(math.PI, 4));
console.log(format.pad(7, 5) + "|");
console.log(format.pad("wide-already", 3));

// deny-by-default capabilities (§5.3)
console.log(caps.list(), caps.has("read"));
try {
    fs.readText("/etc/passwd");
} catch (e: Error) {
    console.log("denied:", e.message);
}
console.log(env.get("HOME"));
