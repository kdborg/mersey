import { console } from "std:console";

// Numeric promotion + defined wrapping (§3.3, §3.6)
let a: int32 = 2147483647;
a = a + 1;                        // wraps
console.log(a);
let mixed = 3 + 2.5;              // int32 + float64 -> float64
console.log(mixed);
let big: int64 = 5000000000l;
console.log(big + 1);
console.log(7 / 2);               // integer division
console.log(7.0 / 2);             // float division
console.log(7 % 3);
console.log(2 ** 10);
console.log(1 << 3, 256 >> 2, 5 & 3, 5 | 3, 5 ^ 3, ~0);

// UTF-32 strings: length counts code points, s[i] is a char (§3.4)
const s: string = "héllo🌊";
console.log(s.length);
console.log(s[1]);
console.log(s[5]);
const t = "ab" + "cd";
console.log(t, t.length);
console.log("apple" < "banana");

// Template literals
const who = "Mersey";
console.log(`Hello, ${who}! 1+1=${1 + 1}`);

// Arrays
const xs = [10, 20, 30];
xs.push(40);
console.log(xs, xs.length, xs[3]);
const doubled = [...xs, 99];
console.log(doubled);
let total = 0;
for (const x of xs) { total += x; }
console.log(total);

// Control flow
let out = "";
for (let i = 0; i < 5; i++) {
    if (i == 2) { continue; }
    out = out + `${i} `;
}
console.log(out);
switch (3) {
    case 1: console.log("one"); break;
    case 3: console.log("three");
    case 4: console.log("fallthrough"); break;
    default: console.log("nope");
}
outer: for (let i = 0; i < 3; i++) {
    for (let j = 0; j < 3; j++) {
        if (j == 1) { continue outer; }
        if (i == 2) { break outer; }
        console.log(i, j);
    }
}

// Records + destructuring
const rec = { name: "sea", size: 3 };
const { name, size = 9 } = rec;
console.log(name, size);
const [p, q = 5, ...rest] = [1, null, 7, 8];
console.log(p, q, rest);

// Conditions are bool-or-numeric (§3.3)
if (3) { console.log("numeric truthy"); }
console.log(0 ? "yes" : "no");
console.log(null ?? "fallback");
