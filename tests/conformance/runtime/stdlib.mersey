import { console } from "std:console";
import { math } from "std:math";
import { bytes } from "std:bytes";
import { regex } from "std:regex";
import { parse } from "std:parse";
import { time } from "std:time";

// math: was abs/min/max/floor/ceil/sqrt/pow and nothing else.
console.log(math.round(2.5), math.round(-2.5), math.trunc(-2.7), math.sign(-3.0), math.sign(0.0));
console.log(math.exp(0.0), math.log(math.E), math.log2(8.0), math.log10(1000.0), math.cbrt(27.0));
console.log(math.sin(0.0), math.cos(0.0), math.hypot(3.0, 4.0), math.clamp(5.0, 0.0, 3.0));
console.log(math.isNaN(0.0 / 0.0), math.isFinite(1.0 / 0.0));

// A Mersey string is code points; bytes are what a file holds.
const b = bytes.encodeUtf8("héllo");
console.log(b.length, bytes.decodeUtf8(b)); // 6 bytes, 5 code points
const bad = bytes.alloc(1);
bad[0] = 255;
console.log(bytes.decodeUtf8(bad)); // invalid UTF-8 -> null, not U+FFFD

// `replace` does the first match; `replaceAll` does all of them.
const re = regex.compile("a+");
console.log(re.replace("aa-aa", "X"), re.replaceAll("aa-aa", "X"));

// Exactly "true"/"false" — no truthiness games, and null rather than a sentinel.
console.log(parse.bool("true"), parse.bool("false"), parse.bool("yes"));

// ISO-8601 in UTC: it round-trips, sorts as text, and means one thing anywhere.
const ms: float64 = 1752307200000.0;
console.log(time.format(ms), time.parse(time.format(ms)) == ms);
console.log(time.parse("12/07/2025"));               // a guess would be a bug
console.log(time.parse("2025-07-12T08:00:00+02:00")); // an offset is not UTC

// Iterators are lazy: `take(3)` on an infinite generator pulls three elements.
let produced: int32 = 0;
function naturals(): int32 {
    let i: int32 = 1;
    while (true) {
        produced += 1;
        yield i;
        i += 1;
    }
}
console.log(naturals().map((n: int32) => n * 10).take(3).toArray(), produced);
produced = 0;
console.log(naturals().filter((n: int32) => n % 2 == 0).take(4).toArray(), produced);

// console has levels; warn/error go to stderr in the CLI.
console.info("info line");
