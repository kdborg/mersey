import { console } from "std:console";

// ---- Array: transforms, predicates, sorting (§1.3: mutation is explicit)
const xs: int32[] = [5, 3, 9, 1, 7];
console.log(xs.map(x => x * 2));
console.log(xs.filter(x => x > 4));
console.log(xs.reduce((acc: int32, x: int32) => acc + x, 0));
console.log(xs.find(x => x > 6), xs.findIndex(x => x > 6));
console.log(xs.some(x => x > 8), xs.every(x => x > 0));
console.log(xs.indexOf(9), xs.contains(4), xs.slice(1, 3));
console.log(xs.concat([100]), xs.toReversed());

const sorted = xs.toSorted((a: int32, b: int32) => a - b);
console.log(sorted, xs);              // toSorted does not mutate
xs.sortInPlace((a: int32, b: int32) => b - a);
console.log(xs);                      // sortInPlace does

let total = 0;
xs.forEach(x => { total += x; });
console.log("forEach total:", total);

// Stable sort: equal keys keep their relative order
const words: string[] = ["bb", "a", "cc", "b", "aa"];
const byLen = words.toSorted((a: string, b: string) => a.length - b.length);
console.log(byLen);

// ---- String
const s = "Hello, Mersey";
console.log(s.replace("l", "L"), s.replaceAll("l", "L"));
console.log("ab".repeat(3), "7".padStart(3, "0"), "x".padEnd(4, "."));
console.log(s.split(", "), s.slice(7), s.toUpperCase());

// ---- Map / Set
const m = new Map<string, int32>();
m.set("a", 1);
m.set("b", 2);
console.log(m.size, m.keys(), m.values());
m.clear();
console.log("cleared:", m.size);

// ---- BigDecimal with a rounding context (§3.7)
const one: bigdec = 1m;
const three: bigdec = 3m;
console.log(one.divide(three, { scale: 4, mode: "HALF_EVEN" }));
console.log(one.divide(3m, { scale: 2, mode: "UP" }));
console.log(1m.divide(2m, { scale: 0, mode: "HALF_EVEN" }));   // ties to even
console.log(3m.divide(2m, { scale: 0, mode: "HALF_EVEN" }));
console.log(19.99m.divide(3m, { scale: 2, mode: "HALF_UP" }));
