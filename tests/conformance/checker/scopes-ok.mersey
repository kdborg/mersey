import { console } from "std:console";
import * as fmt from "std:format";

const LIMIT: int32 = 10;

function tail(): int32 {
    return head() + LIMIT;
}

function head(): int32 {
    return 1;
}

class Node<T extends Comparable<T>> {
    private value: T?;
    private next: Node<T>? = null;

    public constructor(value: T?) {
        this.value = value;
    }

    public insert(other: Node<T>): void {
        let cursor: Node<T>? = this.next;
        while (cursor != null) {
            cursor = cursor?.next;
        }
        this.next = other;
    }
}

class Leaf extends Node<Leaf> implements Comparable<Leaf> {
    private readonly weight: int32;

    public constructor(weight: int32) {
        super(null);
        this.weight = weight;
    }
    public compareTo(other: Leaf): int32 {
        return this.hash() - other.hash();
    }
    public hash(): int32 { return this.weight; }
}

interface Comparable<T> {
    compareTo(other: T): int32;
}

function fetchAll(urls: string[]): int32 {
    let count = 0;
    outer: for (let i = 0; i < LIMIT; i++) {
        while (true) {
            if (i > 3) { continue outer; }
            count += 1;
            break;
        }
    }
    for (const u of urls) {
        count += u.length;
    }
    return count;
}

const shadow: int32 = 1;
function shade(): int32 {
    const shadow: int32 = 2;
    { let shadow: float64 = 3.0; console.log(fmt.pad(shadow)); }
    return shadow;
}

const { a, b: renamed, c = 4 } = source2();
const [x, y = 2, ...zs] = list();
function source2(): { a: int32, b: int32, c: int32 } { return { a: 1, b: 2, c: 3 }; }
function list(): int32[] { return [1]; }

const leaves = new Node<Leaf>(null);
leaves.insert(new Node<Leaf>(new Leaf(3)));
const pair: [string, int32] = ["k", 1];
const handler: (ev: string) => void = ev => console.log(ev, x, y, zs, a, renamed, c, pair);
handler(`total ${tail() + fetchAll(["ab"]) + shade()}`);

export { tail as last, Node };
