// An object stored into a field.
//
// `Op::SetMember` refused this, and the reason was sound about the work — one
// reference-counted value released and another taken — but the price of
// declining was much larger than the store: a constructor that keeps a
// reference could not compile, so no `new` of that class could, so no function
// building one could. A nine-op `Entry(node, v)` took a whole keyed reconciler
// with it (`bench/cli/reconcile`, 12.8x Bun).
//
// The order is the whole correctness argument. `cell_set_obj` takes its
// reference *before* assigning through the cell, because the assignment drops
// whatever the field held — and if the field already held this very object,
// dropping first would free the thing being stored. `selfAssign` below is that
// case, and it reads the object's contents back afterwards rather than its
// identity, because a freed-then-reused cell can still compare equal.

import { console } from "std:console";

class Leaf {
    public tag: int32;
    public constructor(tag: int32) {
        this.tag = tag;
    }
}

class Sub extends Leaf {
    public constructor(tag: int32) {
        super(tag);
    }
}

class Holder {
    public leaf: Leaf;
    public constructor(leaf: Leaf) {
        this.leaf = leaf;
    }
    public swap(l: Leaf): void {
        this.leaf = l;
    }
    /// The field assigned from itself: take-before-drop, or this frees it.
    public selfAssign(): void {
        this.leaf = this.leaf;
    }
}

/// Hot, so the constructor and the setter both compile.
function drive(n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        const h = new Holder(new Leaf(i % 100));
        h.swap(new Leaf(i % 7));
        h.selfAssign();
        acc = acc + h.leaf.tag;
        i += 1;
    }
    return acc;
}

/// A subclass into a field typed as the base — the store the checker allows and
/// the tier has to allow with it.
function viaSub(n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        const h = new Holder(new Sub(i % 5));
        acc = acc + h.leaf.tag;
        i += 1;
    }
    return acc;
}

/// The old value must actually go. Overwrite the same field many times over one
/// long-lived holder; if each store leaked its predecessor this grows without
/// bound, and if it freed too eagerly the read below is of freed memory.
function churn(n: int32): int32 {
    const h = new Holder(new Leaf(0));
    let i = 0;
    while (i < n) {
        h.swap(new Leaf(i % 13));
        i += 1;
    }
    return h.leaf.tag;
}

/// An object pushed onto an array *field*, then read back through it. Two
/// refusals met here: the field read (an array field is (address, elements,
/// length) in registers, which a push can move, so it is read as an opaque when
/// it feeds one) and the argument (`box_arg` had no case for an object, so
/// `xs.push(row)` — what a collection of anything is written to do — was
/// declined). The read-back is by contents, since the push parks a reference and
/// a mis-parked one is a wrong answer rather than a crash.
class Bag {
    private readonly items: Leaf[] = [];
    public add(l: Leaf): int32 {
        this.items.push(l);
        return this.items.length;
    }
    public tagAt(i: int32): int32 {
        return this.items[i].tag;
    }
}

function collect(n: int32): int32 {
    const bag = new Bag();
    let acc = 0;
    let i = 0;
    while (i < n) {
        acc = acc + bag.add(new Leaf(i % 11));
        i += 1;
    }
    return acc + bag.tagAt(0) + bag.tagAt(n - 1);
}

/// An array stored into an array field. `cell_set_arr` is `cell_set_obj`'s twin
/// — an array crosses this tier as `Rc::as_ptr` of its cell, exactly as an
/// instance does — and it takes the new reference before dropping the old for
/// the same reason. `reassign` overwrites the field repeatedly so a leak grows
/// and an over-eager free is read back.
class Shelf {
    private rows: Leaf[] = [];
    public fill(n: int32): void {
        const out: Leaf[] = [];
        let i = 0;
        while (i < n) {
            out.push(new Leaf(i));
            i += 1;
        }
        this.rows = out;
    }
    public at(i: int32): int32 {
        return this.rows[i].tag;
    }
    public size(): int32 {
        return this.rows.length;
    }
}

function reassign(n: int32): int32 {
    const s = new Shelf();
    let acc = 0;
    let i = 0;
    while (i < n) {
        s.fill(3);
        acc = acc + s.at(2) + s.size();
        i += 1;
    }
    return acc;
}

/// An array *from a call* into an array field. It arrives as an opaque handle,
/// not as an address and a length — `ret_is_val_in` counts an array return as an
/// opaque — so this is the store an opaque field gets. It only became possible
/// once a returned opaque stopped handing back a released identity register; see
/// `opaque-return.mersey`.
class Cache {
    private held: Leaf[] = [];
    public refill(n: int32): void {
        this.held = build(n);
    }
    public sum(): int32 {
        let s = 0;
        let i = 0;
        while (i < this.held.length) {
            s = s + this.held[i].tag;
            i += 1;
        }
        return s;
    }
}

function build(n: int32): Leaf[] {
    const out: Leaf[] = [];
    let i = 0;
    while (i < n) {
        out.push(new Leaf(i));
        i += 1;
    }
    return out;
}

function cached(n: int32): int32 {
    const c = new Cache();
    let acc = 0;
    let i = 0;
    while (i < n) {
        c.refill(4);
        acc = acc + c.sum();
        i += 1;
    }
    return acc;
}

console.log(`drive       ${drive(200000)}`);
console.log(`cached      ${cached(50000)}`);
console.log(`reassign    ${reassign(100000)}`);
console.log(`collect     ${collect(20000)}`);
console.log(`viaSub      ${viaSub(200000)}`);
console.log(`churn       ${churn(200000)}`);
// Then read back one at a time, contents not identity.
const a = new Leaf(41);
const h = new Holder(a);
h.selfAssign();
h.selfAssign();
console.log(`selfAssign  ${h.leaf.tag}`);
h.swap(new Leaf(9));
console.log(`swapped     ${h.leaf.tag} ${a.tag}`);
