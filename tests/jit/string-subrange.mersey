// `slice`, `substring`, `charAt` and `codePointAt` on both tiers.
//
// Compiled code reaches these through shims over the receiver's span now, rather
// than through the interpreter's member dispatch: `codePointAt` is a pure
// function of a span and an index, and the other three allocate their result but
// need nothing else the general path costs — no `Value` for the receiver, no
// arena slot per integer argument, no argument vector, no name comparison.
// Worth 6.2x on `codePointAt` and about 4x on `slice` and `substring`.
//
// The bounds arithmetic is shared — one `slice_units`, one `substring_units`,
// called from both tiers — so what this pins is the edges, which is where two
// routes to the same rule come apart: a negative index, a missing second index,
// bounds the wrong way round, an index past the end, and an index that lands
// inside a surrogate pair.
//
// Note what `neg` shows: a negative index clamps to 0 for `slice` and counts
// from the end for `charAt`, and JS does neither. That is existing behaviour,
// unspecified in `docs/spec`, and deliberately left alone here — this pins it so
// that deciding to change it later is a visible decision rather than a drift.

import { console } from "std:console";

/// Every one of them, over the same arguments, packed so a single disagreement
/// changes the line.
function probe(s: string, a: int32, b: int32): string {
    return `[${s.slice(a, b)}|${s.slice(a)}|${s.substring(a, b)}|${s.substring(b, a)}|${s.charAt(a)}|${s.codePointAt(a)}]`;
}

/// Hot enough that the shims are what actually runs.
function drive(n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        acc = acc
            + probe("😀a.b", 1, 3).length
            + probe("abcd", -2, 9).length
            + probe("abcd", 3, 1).length;
        i += 1;
    }
    return acc;
}

console.log(`drive ${drive(200000)}`);
// An index that lands *inside* the surrogate pair, which must give a lone
// surrogate rather than a character or an error.
console.log(`mid   ${probe("😀a.b", 1, 3)}`);
// Negative and past-the-end.
console.log(`neg   ${probe("abcd", -2, 9)}`);
// Bounds the wrong way round: `slice` gives nothing, `substring` swaps them.
console.log(`rev   ${probe("abcd", 3, 1)}`);
// Empty range, and entirely past the end.
console.log(`zero  ${probe("abcd", 0, 0)}`);
console.log(`past  ${probe("abcd", 7, 9)}`);
