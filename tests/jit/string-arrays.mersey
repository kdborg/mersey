// Arrays of strings — read, written and iterated — on both tiers.
//
// An array's elements are `Value`s in a buffer, exactly as an object's fields
// are, so once a string *cell* had a shape a string *element* came almost free:
// reading one is the same cell load, writing one the same copy-into-the-cell.
// That is what `std:path`'s `join(parts: string[])` is made of.
//
// The limit worth stating: this holds for an array whose element type is *known* —
// a parameter, a field. An array built in compiled code is carried as an opaque,
// and an opaque's element has no shape at compile time, so an index read off one
// assumes a number and bails when it is not. Correct, and slow, and refused
// further along rather than silently wrong.

import { console } from "std:console";

/// Reads elements, and their lengths.
function widths(parts: string[], n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        let k = 0;
        while (k < parts.length) {
            acc = acc + parts[k].length;
            k += 1;
        }
        i += 1;
    }
    return acc;
}

/// `for…of` over one, which is the same index loop with the bounds implied.
function joined(parts: string[], n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        for (const p of parts) {
            acc = acc + p.length;
        }
        i += 1;
    }
    return acc;
}

/// Writes elements — the cell takes its own copy of the units.
function relabel(parts: string[], n: int32): int32 {
    let i = 0;
    while (i < n) {
        parts[i % parts.length] = `p${i % 5}`;
        i += 1;
    }
    return parts[0].length + parts[1].length;
}

/// The array `split` hands back. It is an opaque like any container built here,
/// but a *known* one — its elements are strings — so an index read off it has a
/// shape, where a read off a bare opaque has to assume a number and bail when it
/// is not. `length`, a numeric index and `for…of` all work on it.
function fields(text: string, n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        const parts = text.split(",");
        acc = acc + parts.length;
        let k = 0;
        while (k < parts.length) {
            acc = acc + parts[k].length;
            k += 1;
        }
        for (const p of parts) {
            acc = acc + p.length;
        }
        i += 1;
    }
    return acc;
}

const xs: string[] = ["alpha", "be", "gamma"];

widths(xs, 30000);
joined(xs, 30000);
relabel(xs, 30000);
fields("a,bb,ccc", 30000);

console.log(`widths  ${widths(xs, 3)}`);
console.log(`joined  ${joined(xs, 3)}`);
console.log(`relabel ${relabel(xs, 5)}`);
console.log(`fields  ${fields("a,bb,ccc", 4)}`);
