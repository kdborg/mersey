// Shapes Tier 1 learned to take, each in a loop hot enough that it does.
//
// Every one of these ran wholly interpreted before, and the reason each was
// refused is a different missing piece of the same boundary — so the risk they
// share is not "slow" but "different answer": a string arrives as three
// registers, an opaque as an arena handle, and a null as a zero, and getting the
// ownership of any of them wrong is how a value goes missing quietly. What this
// pins is that both tiers print the same numbers.

import { console } from "std:console";
import { bytes } from "std:bytes";

/// A `string` parameter. `param_types` had no register shape for `string`, so
/// the *signature* was unrepresentable and the whole function stayed in Tier 0.
function score(s: string, n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        acc = acc + s.length + (i % 7);
        i += 1;
    }
    return acc;
}

/// `string?` is the same three registers — a null string is a null data
/// pointer — so this compiles too, and must agree about which branch it took.
function widthOf(s: string?, n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        if (s != null) {
            acc = acc + s.length;
        } else {
            acc = acc + 1;
        }
        i += 1;
    }
    return acc;
}

/// An opaque as a live local. `bytes.encodeUtf8` hands back a `Bytes` that
/// compiled code holds only by arena handle; the string argument is boxed (and
/// a *built* one is reused rather than copied); `decodeUtf8` may hand back null,
/// which is handle 0. The payload is deliberately not pure ASCII, so the
/// conversions take their general path rather than their fast one.
function roundTrip(n: int32): int32 {
    let sum = 0;
    let i = 0;
    while (i < n) {
        const b = bytes.encodeUtf8(`p${i}·x`);
        sum = sum + b.length;
        const s = bytes.decodeUtf8(b);
        if (s != null) {
            sum = sum + s.length;
        }
        i += 1;
    }
    return sum;
}

/// A string *return*. `Sig` could describe a number, a bool or a class coming
/// back and nothing else, so `void` meant "not one of those" and any
/// string-returning function was refused. Its callers were refused with it: the
/// result is three registers (data, length, owning handle) and the call site took
/// only the first, so even `label(i).length` could not be emitted.
function label(i: int32): string {
    if (i % 3 == 0) {
        return "zero";
    }
    if (i % 3 == 1) {
        return "one";
    }
    return "two";
}

/// `string?` again, this time coming back — a null return is handle 0, which the
/// caller reads as absent.
function maybe(i: int32): string? {
    if (i % 5 == 0) {
        return null;
    }
    return "some";
}

/// A built string returned from a *compiled* function is the case that has to own
/// its arena entry: a constant is borrowed and gets parked on the way out, but
/// this one already holds a handle and must hand over that one rather than a copy.
function joined(i: int32): string {
    return `n=${i}`;
}

/// The caller: three string-returning calls, a null check on one, and `.length`
/// on all of them.
function tally(n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        acc = acc + label(i).length + joined(i).length;
        const m = maybe(i);
        if (m != null) {
            acc = acc + m.length;
        }
        i += 1;
    }
    return acc;
}

/// An opaque as a *parameter*. `Bytes` is a prelude class with no Mersey layout —
/// there is nothing to look inside — so it crosses as an arena handle, the same
/// shape a native's result takes. Before, the signature was undescribable and the
/// function was refused whole, which is what kept `std:hex`'s `encode(data: Bytes)`
/// and its like in the interpreter.
function span(b: Bytes, n: int32): int32 {
    let acc = 0;
    let i = 0;
    while (i < n) {
        acc = acc + b.length;
        i += 1;
    }
    return acc;
}

console.log(`score     ${score("payload", 200000)}`);
console.log(`span      ${span(bytes.alloc(24), 200000)}`);
console.log(`tally     ${tally(200000)}`);
console.log(`widthOf   ${widthOf("abcd", 200000)} ${widthOf(null, 200000)}`);
console.log(`roundTrip ${roundTrip(200000)}`);
