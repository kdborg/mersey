// A module-level `let` written from inside a function.
//
// Reading one has always compiled — `NameKind::NumGlobal` tells the tier which
// register the binding holds, and `jit_global_num` reads it through `env_get`.
// Writing was refused outright, and a refusal costs the whole enclosing
// function: `bench/cli/reconcile`'s `applyOps` kept an id sequence in a
// module-level `let`, which refused it, which refused `Batch.apply` for having
// called it.
//
// The write is the read's mirror — `env_set`, with the numeric kind decided at
// compile time because the checker fixes a binding's type. All four kinds are
// here, because the bits handed to the shim mean something different in each and
// a mismatch would be a wrong value rather than a bail.

import { console } from "std:console";

let seq: int32 = 0;
let big: int64 = 0;
let total: float64 = 0.0;
let seen: bool = false;

/// Hot, so the writes happen in compiled code.
function bump(n: int32): int32 {
    let i = 0;
    while (i < n) {
        seq += 1;
        big += 3;
        total = total + 0.5;
        i += 1;
    }
    seen = true;
    return seq;
}

/// A second function writing the same bindings: the value must be the live one,
/// not something a frame cached.
function again(n: int32): int32 {
    let i = 0;
    while (i < n) {
        seq += 2;
        i += 1;
    }
    return seq;
}

/// Pushing a module-level `const` onto an array field. The receiver of a `push`
/// is read as an opaque rather than as an address and a length, which a bounded
/// lookahead decides — and that scan has to recognise `LoadName` as an argument,
/// not just a slot or a literal. Leaving it out refused every op-emitting method
/// in `bench/cli/reconcile`'s batch class, each of which is written exactly like
/// `emit` below.
const TAG_A: int32 = 7;
const TAG_B: int32 = 11;

class Ops {
    private readonly out: int32[] = [];
    public emit(): void {
        this.out.push(TAG_A);
        this.out.push(TAG_B);
        // The argument is itself a call. No list of op kinds can recognise this
        // — finding the `push` that owns a receiver needs the verifier's stack
        // depth at each pc, which is what `feeds_a_push` reads.
        this.out.push(this.wrap(TAG_A));
    }
    private wrap(v: int32): int32 {
        return v * 2;
    }
    public total(): int32 {
        let s = 0;
        let i = 0;
        while (i < this.out.length) {
            s = s + this.out[i];
            i += 1;
        }
        return s;
    }
}

function emitting(n: int32): int32 {
    const o = new Ops();
    let i = 0;
    while (i < n) {
        o.emit();
        i += 1;
    }
    return o.total();
}

console.log(`bump   ${bump(200000)}`);
console.log(`emit   ${emitting(20000)}`);
console.log(`again  ${again(100000)}`);
// Read back from the top level, which is interpreted — so these values only
// agree if the compiled writes went to the real binding.
console.log(`state  ${seq} ${big} ${total} ${seen}`);
