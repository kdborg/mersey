// Keyed lookup, in insertion order.
//
// `get` returns a `V?`: a missing key is `null`, and you have to deal with it.
// `remove` is what other languages call `delete` — verb-first, like everything
// else (§1.3).
import { console } from "std:console";

const ages = new Map<string, int32>();
ages.set("ada", 36);
ages.set("alan", 41);

console.log(ages.size, ages.get("ada"), ages.get("nobody"));
console.log(ages.has("alan"), ages.remove("alan"), ages.has("alan"));

// A missing key is null, so the default is yours to choose.
const age = ages.get("nobody");
console.log(age == null ? -1 : age);

ages.set("grace", 45);
console.log(ages.keys(), ages.values());
for (const k of ages.keys()) {
    console.log(k, "->", ages.get(k));
}
