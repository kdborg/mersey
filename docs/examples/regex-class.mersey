// A compiled pattern.
//
// `find` gives the first match or `null`; `findAll` gives every match. A match is
// a record — its text, where it started and ended (in *code points*), and its
// capture groups, each of which may be null if it did not participate.
//
// `replace` does the first match; `replaceAll` does all of them. Neither name can
// be mistaken for the other (§1.3).
import { console } from "std:console";
import { regex } from "std:regex";

const re = regex.compile("(\\w+)@(\\w+)");
const m = re.find("mail bob@example now");
if (m != null) {
    console.log(m.text, m.start, m.end);
    console.log(m.groups[0], m.groups[1]);
}

const all = regex.compile("[0-9]+").findAll("a1b22c333");
console.log(all.length, all[0].text, all[2].text);

const digits = regex.compile("[0-9]+");
console.log(digits.replace("a1b2", "#"), digits.replaceAll("a1b2", "#"));
console.log(regex.compile(",\\s*").split("a, b,c").join("|"));
