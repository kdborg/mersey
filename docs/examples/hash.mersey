// Cryptographic digests — SHA-256 (std:hash).
//
// `sha256` takes a `std:bytes` buffer and returns the 32-byte digest. It is
// pure computation (no capability needed) — hashing reads bytes, it does not
// touch the world. Pair it with `std:hex` or `std:base64` to render the digest,
// and `std:bytes` to feed it text.
import { console } from "std:console";
import { hash } from "std:hash";
import { bytes } from "std:bytes";
import { encode } from "std:hex";

const digest = hash.sha256(bytes.encodeUtf8("abc"));
console.log(digest.length);      // 32 bytes
console.log(encode(digest));     // the canonical SHA-256("abc")

// HMAC-SHA-256 signs a message with a secret key — the basis of a signed
// cookie or a JWT. Same key and message, same tag, every time.
const tag = hash.hmacSha256(bytes.encodeUtf8("secret"), bytes.encodeUtf8("session=42"));
console.log(encode(tag));
