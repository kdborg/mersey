// A collection with no duplicates, in insertion order.
//
// `values()` gives the elements as an array — there is no separate `toArray`,
// because two names for one thing is exactly what §1.3 forbids.
import { console } from "std:console";

const seen = new Set<int32>();
seen.add(1);
seen.add(2);
seen.add(1);   // already there

console.log(seen.size, seen.has(1), seen.has(9));
console.log(seen.values());

console.log(seen.remove(1), seen.has(1), seen.size);

for (const v of seen.values()) {
    console.log(v);
}
