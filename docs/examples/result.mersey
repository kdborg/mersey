// A value, or an error — as a value.
//
// Use it when failure is *ordinary* and the caller should decide what to do:
// a parse that might not parse, a lookup that might miss. Throwing is for the
// exceptional; a `Result` is for the expected (§1.3).
//
// It is written in Mersey and loaded through the module graph like any other
// import — the standard library is not a privileged place.
import { console } from "std:console";
import { Result, ok, err } from "std:result";

function half(n: int32): Result<int32, string> {
    if (n % 2 != 0) {
        return err("not even");
    }
    return ok(n / 2);
}

const good = half(10);
console.log(good.isOk(), good.unwrap(), good.unwrapErr());

const bad = half(7);
console.log(bad.isOk(), bad.isErr(), bad.unwrapErr());

// The caller decides what a failure means — that is the whole point.
console.log(half(10).unwrapOr(-1), half(7).unwrapOr(-1));
