// The query part of a URL, as an ordered list of pairs.
//
// A key may appear more than once — that is what `getAll` is for — so `get`
// returns the *first*, and `null` when there is none. Percent-encoding is
// handled in both directions, over UTF-8 bytes, so a non-ASCII value survives a
// round trip.
//
// `removeAll` is what JS spells `delete`: verb-first, and the name says it
// mutates (§1.3).
import { console } from "std:console";
import { URLSearchParams } from "std:url";

const p = new URLSearchParams("?a=1&a=2&b=hello+world&c=caf%C3%A9");
console.log(p.get("a"), p.getAll("a"), p.get("b"), p.get("c"));
console.log(p.has("b"), p.has("zz"), p.size());

p.append("a", "3");         // keeps the ones already there
console.log(p.getAll("a"));
p.set("a", "only");         // replaces them all
console.log(p.getAll("a"));
p.removeAll("b");
console.log(p.toString());

// Non-ASCII goes out as UTF-8 percent-escapes and comes back whole.
const round = new URLSearchParams(new URLSearchParams("n=café&s=a b/c").toString());
console.log(round.get("n"), round.get("s"));
