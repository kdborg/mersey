// caps: env
//
// Environment variables — behind a capability.
//
// Denied by default; `--allow-env` grants it. A variable that is not set is
// `null`, not `""` — the caller has to say what to do about that, which is the
// difference between a missing value and an empty one.
import { console } from "std:console";
import { env } from "std:env";

const unset = env.get("MERSEY_DOC_EXAMPLE_NOT_SET");
console.log(unset);
console.log(unset == null ? "default" : unset);
