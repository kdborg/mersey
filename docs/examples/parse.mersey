// Strings to numbers — and `null` when they are not.
//
// Every parser returns a nullable: bad input is `null`, never a sentinel like
// `NaN` or `-1`, and never an exception for input you already expected to be
// dubious (§1.3). You have to say what to do about failure, which is the point.
import { console } from "std:console";
import { parse } from "std:parse";

const n = parse.int32("42");
console.log(n, parse.int32("not a number"));

// A radix, when you want one.
console.log(parse.int32("ff", 16), parse.int32("1010", 2));

// The null has to be dealt with — that is what makes it safe.
const maybe = parse.float64("3.5");
console.log(maybe == null ? 0.0 : maybe + 1.0);

console.log(parse.int64("9007199254740993"), parse.bigint("123456789012345678901234567890"));

// Exactly "true" or "false". No truthiness games: "yes" is not a boolean.
console.log(parse.bool("true"), parse.bool("false"), parse.bool("yes"));
