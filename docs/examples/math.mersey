// Numbers.
//
// `abs`, `min` and `max` are generic in a `Numeric` type parameter, so they keep
// the width they were given: `abs(-3)` is an `int32`, `abs(-3.5)` a `float64`.
// (They used to be untyped, which is why `math.abs("hi")` once compiled.)
// Everything else takes and returns `float64`.
//
// There is no `math.random` — randomness is authority, not arithmetic, so it
// lives behind a capability in `std:random`.
import { console } from "std:console";
import { math } from "std:math";

// Width is preserved.
const i: int32 = math.abs(-3);
const f: float64 = math.abs(-3.5);
console.log(i, f, math.min(3, 1, 2), math.max(1.5, 2.5));

// Rounding. `round` is round-half-away-from-zero; `trunc` drops the fraction.
console.log(math.round(2.5), math.round(-2.5), math.floor(-2.5), math.ceil(-2.5), math.trunc(-2.5));

// `sign` propagates NaN rather than inventing a sign for it.
console.log(math.sign(-3.0), math.sign(0.0), math.isNaN(math.sign(0.0 / 0.0)));

console.log(math.sqrt(16.0), math.cbrt(27.0), math.pow(2.0, 10.0), math.hypot(3.0, 4.0));
console.log(math.exp(0.0), math.log(math.E), math.log2(8.0), math.log10(1000.0));
console.log(math.clamp(5.0, 0.0, 3.0), math.isFinite(1.0 / 0.0), math.PI > 3.0);
